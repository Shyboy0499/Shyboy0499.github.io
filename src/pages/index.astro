---
// 站点唯一页面：顶部是卡通风格的像素房间任务入口，下方是精选作品、全部仓库、视觉作品与关于。
// 页面只负责结构与样式；运行时在 scripts/（quest.ts、repos.ts），数据在 content/*.ts。
import { profile, projects } from "../content/projects";
import { artworks } from "../content/gallery";
import { missions } from "../content/missions";
import { GITHUB_USER, SNAPSHOT } from "../content/github";

const year = new Date().getFullYear();
const keywords = ["TypeScript", "Python", "Swift", "AI agents", "Git automation", "Program synthesis", "LLM tooling", "Open source"];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{profile.name} — {profile.handle}</title>
    <meta name="description" content={profile.blurb} />
    <meta property="og:title" content={profile.name} />
    <meta property="og:description" content={profile.blurb} />
    <meta property="og:type" content="website" />
    <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'%3E%3Ctext y='.9em' font-size='90'%3E%E2%9C%A6%3C/text%3E%3C/svg%3E" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Fredoka:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <nav class="nav">
      <a class="brand" href="#top"><span class="brand-mark">★</span> {profile.name}</a>
      <div class="nav-links">
        <a href="#quest">Play</a>
        <a href="#work">Work</a>
        <a href="#repos">Repos</a>
        <a href="#studio">Studio</a>
        <a href="#about">About</a>
        <a class="nav-cta" href={profile.github} target="_blank" rel="noopener noreferrer">GitHub ↗</a>
      </div>
    </nav>

    <main id="top">
      <!-- 任务式入口：房间里的物件各自揭示一段信息，四个任务全部完成后打开大门。 -->
      <section id="quest" class="quest" aria-labelledby="quest-title">
        <header class="quest-head">
          <p class="sticker">{profile.handle} · a quest intro</p>
          <h1 id="quest-title" class="title">{profile.name}</h1>
          <p class="lede">{profile.blurb}</p>
        </header>

        <aside class="player-card" aria-label="Player card">
          <img class="pc-avatar" src="/art/studio-cat.jpg" alt="" width="66" height="66" />
          <div class="pc-body">
            <p class="pc-name">{profile.name}</p>
            <p class="pc-class">Builder of agents and tools</p>
            <div class="pc-bar" role="progressbar" aria-label="Quest progress" aria-valuemin="0" data-pc-bar data-keys={JSON.stringify(missions.flatMap((m) => m.keys))}>
              <i data-pc-fill></i>
            </div>
            <p class="pc-xp" data-pc-xp>Quest progress</p>
          </div>
          <span class="pc-level" data-pc-level>Lv.1</span>
          <span class="pc-status">Currently: building in public</span>
        </aside>

        <div class="quest-layout">
          <div class="stage">
            <canvas class="game" data-canvas tabindex="0" role="img" aria-label="A small cartoon room. Walk with the arrow keys or WASD, press E to read an object. Finish the four missions to open the gate to the portfolio."></canvas>

            <div class="start">
              <button class="btn btn-big" type="button" data-start>Start quest!</button>
              <p class="start-hint">Arrow keys or WASD to walk · E to interact</p>
            </div>

            <div class="dialog" data-dialog hidden>
              <p class="dialog-title" data-dialog-title></p>
              <p class="dialog-text" data-dialog-text></p>
              <p class="dialog-next">▸ E / tap to continue</p>
            </div>

            <p class="hud-hint" data-hint aria-live="polite"></p>

            <p class="toast" data-toast role="status" hidden></p>

            <div class="cinema" data-cinema hidden>
              <div class="bar bar-top"></div>
              <div class="cinema-body">
                <p class="sticker" data-cinema-sticker>Chapter 1</p>
                <h3 class="cinema-title" data-cinema-title>A quest begins</h3>
                <p class="cinema-sub" data-cinema-sub>Find the four things I want you to know.</p>
                <button class="btn btn-big" type="button" data-cinema-go hidden>See the work ↓</button>
              </div>
              <div class="bar bar-bottom"></div>
            </div>

            <div class="touch">
              <div class="dpad">
                <button type="button" data-dir="up" aria-label="Walk up">▲</button>
                <button type="button" data-dir="left" aria-label="Walk left">◀</button>
                <button type="button" data-dir="right" aria-label="Walk right">▶</button>
                <button type="button" data-dir="down" aria-label="Walk down">▼</button>
              </div>
              <button class="action" type="button" data-action aria-label="Interact">E</button>
            </div>
          </div>

          <aside class="notes" aria-label="Field notes">
            <div class="notes-head">
              <h2>Field notes</h2>
              <span class="progress" data-progress>0 / {missions.length}</span>
            </div>
            <ol class="missions">
              {
                missions.map((m) => (
                  <li data-mission={m.id}>
                    <span class="check" aria-hidden="true">✓</span>
                    <div>
                      <p class="m-title">
                        {m.title}
                        <span class="m-count" data-count></span>
                      </p>
                      <p class="m-summary" data-summary hidden></p>
                    </div>
                  </li>
                ))
              }
            </ol>
            <button class="reset" type="button" data-reset>Reset progress</button>
          </aside>
        </div>

        <noscript>
          <style>.stage, .notes { display: none; }</style>
          <p class="fallback">Scripts are off, so the quest is hidden. Everything it reveals is in the sections below.</p>
        </noscript>
      </section>

      <div class="marquee" aria-hidden="true">
        <div class="marquee-track">
          {[...keywords, ...keywords].map((k) => <span class="chip">{k}<span class="sep">★</span></span>)}
        </div>
      </div>

      <!-- 精选作品：Bento 网格，首张大卡片；指针在卡片上移动时点亮高光。 -->
      <section id="work" class="section" data-reveal>
        <header class="section-head">
          <p class="sticker">01 — Work</p>
          <h2>Selected projects</h2>
        </header>
        <div class="bento">
          {
            projects.map((p, i) => (
              <a
                class={`tile${i === 0 ? " tile-wide" : ""}`}
                href={p.href}
                target="_blank"
                rel="noopener noreferrer"
                style={`--accent:${p.accent}`}
              >
                <svg class="tile-glyph" viewBox="0 0 100 100" aria-hidden="true">
                  <polygon points="50,6 92,38 50,94 8,38" />
                  <polyline points="8,38 50,50 92,38" />
                  <line x1="50" y1="6" x2="50" y2="50" />
                  <line x1="50" y1="50" x2="50" y2="94" />
                </svg>
                <div class="tile-top">
                  <span class="tile-index">0{i + 1}</span>
                  <span class="tile-lang">{p.lang}</span>
                </div>
                <h3 class="tile-name">{p.name}</h3>
                <p class="tile-blurb">{p.blurb}</p>
                <div class="tile-foot">
                  <span class="tile-star">★ {p.stars}</span>
                  <span class="tile-open">Open repository <span aria-hidden="true">↗</span></span>
                </div>
              </a>
            ))
          }
        </div>
      </section>

      <!-- 全部仓库：浏览器里从 GitHub 实时读取公开仓库，数字与列表都会更新。 -->
      <section id="repos" class="section" data-reveal>
        <header class="section-head">
          <p class="sticker">02 — Repos · live</p>
          <h2>Everything on GitHub</h2>
          <p class="repo-intro">
            Read straight from <a href={`https://github.com/${GITHUB_USER}`} target="_blank" rel="noopener noreferrer">{GITHUB_USER}</a>'s
            public repos when you open this page. Private repos count in the total but aren't listed.
          </p>
        </header>

        <dl class="stats">
          <div class="stat-a"><dt>Repos</dt><dd data-stat="repos">{SNAPSHOT.repos}</dd></div>
          <div class="stat-b"><dt>GitHub stars</dt><dd data-stat="stars">{SNAPSHOT.stars}</dd></div>
          <div class="stat-c"><dt>Languages</dt><dd data-stat="languages">{SNAPSHOT.languages}</dd></div>
        </dl>

        <div class="repo-controls">
          <input type="search" data-repo-search placeholder="Search name, topic, or language…" aria-label="Search repositories" />
          <select data-repo-lang aria-label="Filter by language">
            <option value="">All languages</option>
          </select>
          <select data-repo-sort aria-label="Sort repositories">
            <option value="stars">Most stars</option>
            <option value="updated">Recently updated</option>
            <option value="name">Name</option>
          </select>
          <label class="toggle"><input type="checkbox" data-repo-forks /> Include forks</label>
        </div>

        <p class="repo-status" data-repo-status aria-live="polite">Loading from GitHub…</p>
        <ul class="repo-grid" data-repo-grid></ul>
        <button class="more-btn" type="button" data-repo-more hidden>Show more</button>
      </section>

      <!-- 工作室：用代码生成的图片。点击任一张可放大，并看到它是怎么画出来的。 -->
      <section id="studio" class="section" data-reveal>
        <header class="section-head">
          <p class="sticker">03 — Studio</p>
          <h2>Pictures made with code</h2>
          <p class="studio-intro">
            Most of these are generated by a small script (<code>scripts/gen-art.mjs</code>) with a fixed seed,
            so running it again gives the same picture. The first one is a photo of the studio cat.
            Click any picture to see it larger and read how it was made.
          </p>
        </header>
        <div class="gallery">
          {
            artworks.map((a, i) => (
              <button
                class={`art${i === 0 ? " art-feature" : ""}`}
                type="button"
                data-art={i}
                data-src={a.src}
                data-title={a.title}
                data-note={a.note}
                data-alt={a.alt}
                data-how={a.how}
              >
                <img src={a.src} alt={a.alt} loading="lazy" decoding="async" />
                <span class="art-cap">
                  <span class="art-title">{a.title}</span>
                  <span class="art-note">{a.note}</span>
                </span>
              </button>
            ))
          }
        </div>

        <dialog class="lightbox" data-lightbox>
          <img data-lightbox-img src="" alt="" />
          <div class="lightbox-body">
            <p class="lightbox-title" data-lightbox-title></p>
            <p class="lightbox-note" data-lightbox-note></p>
            <p class="lightbox-how" data-lightbox-how></p>
            <button class="more-btn" type="button" data-lightbox-close>Close</button>
          </div>
        </dialog>
      </section>

      <section id="about" class="section about" data-reveal>
        <header class="section-head">
          <p class="sticker">04 — About</p>
        </header>
        <p class="statement">
          I build tools that <mark>check their own work</mark>: agents, git automation, and the
          Mac setups that make a machine feel like mine.
        </p>
        <div class="about-links">
          <a href={profile.github} target="_blank" rel="noopener noreferrer">GitHub ↗</a>
          <a href={`mailto:${profile.email}`}>Email ↗</a>
        </div>
      </section>

      <footer class="footer">
        <div class="giant" aria-hidden="true">Chris Yu</div>
        <div class="footer-row">
          <span>★ {profile.name} · {profile.handle}</span>
          <span>© {year} · Built with care</span>
        </div>
      </footer>
    </main>

    <!-- 页面切换时的擦除转场：由 quest.ts 在前往作品区时触发。 -->
    <div class="wipe" data-wipe aria-hidden="true"></div>

    <script>
      import { mountQuest } from "../scripts/quest";
      import { mountRepos } from "../scripts/repos";

      const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

      const quest = document.getElementById("quest");
      if (quest) mountQuest(quest);

      // 玩家卡：读取本机的任务进度，只更新经验条与等级，不影响游戏本身。
      const pcBar = document.querySelector<HTMLElement>("[data-pc-bar]");
      const pcFill = document.querySelector<HTMLElement>("[data-pc-fill]");
      const pcXp = document.querySelector<HTMLElement>("[data-pc-xp]");
      const pcLevel = document.querySelector<HTMLElement>("[data-pc-level]");
      if (pcBar && pcFill && pcXp && pcLevel) {
        const keys: string[] = JSON.parse(pcBar.dataset.keys ?? "[]");
        let visited: string[] = [];
        try {
          visited = JSON.parse(localStorage.getItem("quest-visited-v1") ?? "[]");
        } catch {
          visited = [];
        }
        const done = keys.filter((k) => visited.includes(k)).length;
        const pct = keys.length ? Math.round((done / keys.length) * 100) : 0;
        pcBar.setAttribute("aria-valuemax", String(keys.length));
        pcBar.setAttribute("aria-valuenow", String(done));
        requestAnimationFrame(() => {
          pcFill.style.width = pct + "%";
        });
        pcXp.textContent = `${done} / ${keys.length} keys found`;
        pcLevel.textContent = `Lv.${1 + done}`;
      }

      const repos = document.getElementById("repos");
      if (repos) mountRepos(repos);

      // 作品灯箱：点击作品放大，显示标题、类型与制作方法。
      const lightbox = document.querySelector<HTMLDialogElement>("[data-lightbox]");
      const lbImg = document.querySelector<HTMLImageElement>("[data-lightbox-img]");
      const lbTitle = document.querySelector<HTMLElement>("[data-lightbox-title]");
      const lbNote = document.querySelector<HTMLElement>("[data-lightbox-note]");
      const lbHow = document.querySelector<HTMLElement>("[data-lightbox-how]");
      document.querySelectorAll<HTMLButtonElement>("[data-art]").forEach((btn) => {
        btn.addEventListener("click", () => {
          if (!lightbox || !lbImg || !lbTitle || !lbNote || !lbHow) return;
          lbImg.src = btn.dataset.src ?? "";
          lbImg.alt = btn.dataset.alt ?? "";
          lbTitle.textContent = btn.dataset.title ?? "";
          lbNote.textContent = btn.dataset.note ?? "";
          lbHow.textContent = btn.dataset.how ?? "";
          lightbox.showModal();
        });
      });
      document.querySelector<HTMLButtonElement>("[data-lightbox-close]")?.addEventListener("click", () => lightbox?.close());
      lightbox?.addEventListener("click", (e) => {
        // 点击灯箱外侧（遮罩）时关闭。
        if (e.target === lightbox) lightbox.close();
      });

      // 作品卡片：指针位置写入 CSS 变量，驱动高光跟随。
      document.querySelectorAll<HTMLElement>(".tile").forEach((tile) => {
        tile.addEventListener("pointermove", (e) => {
          const r = tile.getBoundingClientRect();
          tile.style.setProperty("--mx", `${e.clientX - r.left}px`);
          tile.style.setProperty("--my", `${e.clientY - r.top}px`);
        });
      });

      // 段落进入视口时弹出。
      const revealEls = document.querySelectorAll<HTMLElement>("[data-reveal]");
      if (reduce) {
        revealEls.forEach((el) => el.classList.add("in"));
      } else {
        const io = new IntersectionObserver(
          (entries) => {
            for (const en of entries) {
              if (en.isIntersecting) {
                en.target.classList.add("in");
                io.unobserve(en.target);
              }
            }
          },
          { threshold: 0.12 },
        );
        revealEls.forEach((el) => io.observe(el));
      }
    </script>

    <style is:global>
      :root {
        --sky: #9be2ff;
        --sky-light: #e9faff;
        --ink: #1d1433;
        --cream: #fff6e5;
        --sun: #ffd23f;
        --coral: #ff6b6b;
        --mint: #5ee6b8;
        --violet: #7b5cff;
        --pink: #ff9ecf;
        --blue: #3b4cca;
        --font: "Fredoka", system-ui, sans-serif;
        --pop: 6px 6px 0 var(--ink);
        --ease: cubic-bezier(0.34, 1.4, 0.64, 1);
      }

      * { box-sizing: border-box; }
      html { scroll-behavior: smooth; }
      body {
        margin: 0;
        background: linear-gradient(180deg, var(--sky) 0%, var(--sky-light) 45%, var(--sky-light) 100%);
        color: var(--ink);
        font-family: var(--font);
        font-size: 17px;
        line-height: 1.5;
        overflow-x: hidden;
      }
      a { color: inherit; }
      [hidden] { display: none !important; }
      :focus-visible { outline: 3px solid var(--violet); outline-offset: 3px; }
      code { font-family: ui-monospace, monospace; font-size: 0.9em; background: var(--cream); border: 2px solid var(--ink); border-radius: 8px; padding: 0 5px; }

      .sticker {
        display: inline-block;
        margin: 0;
        padding: 4px 14px;
        background: var(--sun);
        border: 3px solid var(--ink);
        border-radius: 999px;
        box-shadow: 3px 3px 0 var(--ink);
        font-size: 0.85rem;
        font-weight: 600;
        letter-spacing: 0.02em;
        transform: rotate(-2deg);
      }
      .btn {
        display: inline-flex;
        align-items: center;
        padding: 12px 26px;
        border: 3px solid var(--ink);
        border-radius: 16px;
        background: var(--sun);
        color: var(--ink);
        font: inherit;
        font-weight: 700;
        box-shadow: var(--pop);
        cursor: pointer;
        transition: transform 0.12s var(--ease), box-shadow 0.12s;
      }
      .btn:hover { transform: translate(-2px, -2px); box-shadow: 8px 8px 0 var(--ink); }
      .btn:active { transform: translate(4px, 4px); box-shadow: 2px 2px 0 var(--ink); }
      .btn-big { font-size: 1.4rem; padding: 16px 38px; }
      .more-btn {
        margin-top: 1.4rem;
        padding: 10px 20px;
        border: 3px solid var(--ink);
        border-radius: 999px;
        background: var(--mint);
        color: var(--ink);
        font: inherit;
        font-weight: 700;
        box-shadow: 3px 3px 0 var(--ink);
        cursor: pointer;
      }
      .more-btn:hover { transform: translate(-1px, -1px); }

      /* ---------- 导航 ---------- */
      .nav {
        position: fixed;
        top: 0; left: 0; right: 0;
        z-index: 20;
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 14px clamp(16px, 4vw, 48px);
        pointer-events: none;
      }
      .nav > * { pointer-events: auto; }
      .brand {
        padding: 6px 14px;
        background: var(--cream);
        border: 3px solid var(--ink);
        border-radius: 999px;
        box-shadow: 3px 3px 0 var(--ink);
        font-weight: 700;
        text-decoration: none;
      }
      .brand-mark { color: var(--coral); }
      .nav-links {
        display: flex;
        align-items: center;
        gap: 6px;
        padding: 6px;
        background: var(--cream);
        border: 3px solid var(--ink);
        border-radius: 999px;
        box-shadow: 3px 3px 0 var(--ink);
      }
      .nav-links a:not(.nav-cta) { padding: 4px 12px; border-radius: 999px; text-decoration: none; font-weight: 500; transition: background 0.15s; }
      .nav-links a:not(.nav-cta):hover { background: var(--sky); }
      .nav-cta { padding: 5px 14px; background: var(--mint); border: 2px solid var(--ink); border-radius: 999px; text-decoration: none; font-weight: 700; }
      .nav-cta:hover { background: var(--pink); }

      main { margin: 0 auto; }

      /* ---------- 任务入口 ---------- */
      .quest {
        position: relative;
        max-width: 1180px;
        margin: 0 auto;
        padding: 120px clamp(18px, 5vw, 40px) 50px;
      }
      /* 玩家卡：右上角的一张卡通角色卡，显示头像、等级与本机的任务进度（只读）。 */
      .player-card {
        position: absolute;
        top: 120px;
        right: clamp(18px, 5vw, 40px);
        z-index: 2;
        width: 270px;
        display: flex;
        gap: 12px;
        align-items: center;
        padding: 14px;
        background: var(--cream);
        border: 4px solid var(--ink);
        border-radius: 22px;
        box-shadow: 6px 6px 0 var(--ink);
        transform: rotate(2deg);
        transition: transform 0.25s var(--ease);
      }
      .player-card:hover { transform: rotate(0deg) translateY(-3px); }
      .pc-avatar {
        flex-shrink: 0;
        width: 66px;
        height: 66px;
        object-fit: cover;
        object-position: 50% 55%;
        border: 3px solid var(--ink);
        border-radius: 50%;
        background: var(--sun);
      }
      .pc-body { min-width: 0; flex: 1; }
      .pc-name { margin: 0; font-weight: 700; font-size: 1.05rem; line-height: 1.2; }
      .pc-class { margin: 0 0 8px; font-size: 0.82rem; font-weight: 500; color: #3d3556; }
      .pc-bar {
        height: 14px;
        overflow: hidden;
        background: #ffffff;
        border: 3px solid var(--ink);
        border-radius: 999px;
      }
      .pc-bar i {
        display: block;
        height: 100%;
        width: 0;
        background: linear-gradient(90deg, var(--mint), var(--sun));
        transition: width 0.8s var(--ease);
      }
      .pc-xp { margin: 6px 0 0; font-size: 0.78rem; font-weight: 600; }
      .pc-level {
        position: absolute;
        top: -14px;
        right: -10px;
        padding: 2px 10px;
        background: var(--coral);
        border: 3px solid var(--ink);
        border-radius: 999px;
        font-weight: 700;
        font-size: 0.85rem;
        box-shadow: 2px 2px 0 var(--ink);
      }
      .pc-status {
        position: absolute;
        left: -10px;
        bottom: -16px;
        padding: 2px 10px;
        background: #ffffff;
        border: 3px solid var(--ink);
        border-radius: 999px;
        font-size: 0.75rem;
        font-weight: 600;
        transform: rotate(-3deg);
      }
      @media (max-width: 900px) {
        .player-card { position: relative; top: auto; right: auto; margin: 0 0 28px; transform: none; }
        .player-card:hover { transform: none; }
      }
      .title {
        position: relative;
        margin: 0.5rem 0 0;
        font-size: clamp(3.2rem, 10vw, 6.4rem);
        line-height: 0.95;
        font-weight: 700;
        color: var(--sun);
        -webkit-text-stroke: 3px var(--ink);
        paint-order: stroke fill;
        text-shadow: 5px 5px 0 var(--ink);
        letter-spacing: -0.01em;
      }
      .lede { margin: 1rem 0 0; max-width: 40ch; font-size: clamp(1.05rem, 2vw, 1.25rem); font-weight: 500; }

      .quest-layout {
        margin-top: 2.2rem;
        display: grid;
        grid-template-columns: minmax(0, 1fr) 300px;
        gap: 26px;
        align-items: start;
      }
      .stage { position: relative; }
      .game {
        display: block;
        width: 100%;
        height: auto;
        aspect-ratio: 24 / 14;
        image-rendering: pixelated;
        border: 4px solid var(--ink);
        border-radius: 22px;
        background: #f2c78a;
        box-shadow: 10px 10px 0 var(--ink);
      }
      /* 扫描线与暗角叠在画面上，让像素画更有"屏幕"的质感；不接收指针事件。 */
      .stage::before {
        content: "";
        position: absolute;
        inset: 0;
        z-index: 1;
        border-radius: 18px;
        pointer-events: none;
        background:
          repeating-linear-gradient(0deg, rgba(29, 20, 51, 0.1) 0 1px, transparent 1px 3px),
          radial-gradient(ellipse at center, transparent 60%, rgba(29, 20, 51, 0.35) 100%);
        mix-blend-mode: multiply;
      }
      .start, .dialog, .hud-hint { z-index: 4; }
      .start {
        position: absolute;
        inset: 0;
        display: grid;
        place-content: center;
        justify-items: center;
        gap: 16px;
        border-radius: 18px;
        background: rgba(255, 246, 229, 0.82);
      }
      .is-started .start { display: none; }
      .start-hint {
        margin: 0;
        padding: 6px 14px;
        background: var(--cream);
        border: 2px solid var(--ink);
        border-radius: 999px;
        font-size: 0.95rem;
        font-weight: 500;
      }

      /* 对话气泡：墨线圆角框，底部一个小尾巴指向房间。 */
      .dialog {
        position: absolute;
        left: 22px;
        right: 22px;
        bottom: 26px;
        padding: 14px 20px 16px;
        background: var(--cream);
        border: 4px solid var(--ink);
        border-radius: 20px;
        box-shadow: 6px 6px 0 var(--ink);
      }
      .dialog::after {
        content: "";
        position: absolute;
        left: 50%;
        bottom: -18px;
        width: 22px;
        height: 22px;
        background: var(--cream);
        border-right: 4px solid var(--ink);
        border-bottom: 4px solid var(--ink);
        transform: translateX(-50%) rotate(45deg);
      }
      .dialog-title {
        display: inline-block;
        margin: 0;
        padding: 2px 12px;
        background: var(--pink);
        border: 2px solid var(--ink);
        border-radius: 999px;
        font-size: 0.9rem;
        font-weight: 700;
      }
      .dialog-text { margin: 0.5rem 0 0; min-height: 2.6em; font-size: 1.12rem; font-weight: 500; }
      .dialog-next { margin: 0.4rem 0 0; font-size: 0.85rem; font-weight: 600; color: var(--blue); }

      .hud-hint {
        position: absolute;
        top: 16px;
        left: 16px;
        margin: 0;
        padding: 5px 14px;
        background: var(--cream);
        border: 3px solid var(--ink);
        border-radius: 999px;
        box-shadow: 3px 3px 0 var(--ink);
        font-size: 0.92rem;
        font-weight: 600;
        pointer-events: none;
      }
      .hud-hint:empty { display: none; }

      .toast {
        position: absolute;
        top: 16px;
        right: 16px;
        z-index: 6;
        margin: 0;
        padding: 6px 14px;
        background: var(--mint);
        border: 3px solid var(--ink);
        border-radius: 999px;
        box-shadow: 3px 3px 0 var(--ink);
        font-weight: 700;
        opacity: 0;
        transform: translateY(-8px) rotate(-2deg);
        pointer-events: none;
      }
      .toast.show { opacity: 1; transform: none; transition: opacity 0.25s, transform 0.35s var(--ease); }

      /* 过场：上下两条墨色"电影黑边"滑入，中间是黄色的章节卡片。 */
      .cinema {
        position: absolute;
        inset: 0;
        z-index: 7;
        display: grid;
        grid-template-rows: 16% 1fr 16%;
        border-radius: 18px;
        overflow: hidden;
      }
      .bar { background: var(--ink); transform: scaleY(0); transition: transform 0.6s var(--ease); }
      .bar-top { transform-origin: top; }
      .bar-bottom { transform-origin: bottom; }
      .cinema.show .bar { transform: scaleY(1); }
      .cinema-body {
        display: grid;
        place-content: center;
        justify-items: center;
        gap: 12px;
        text-align: center;
        padding: 0 24px;
        background: radial-gradient(circle, #ffe27a 0%, var(--cream) 75%);
        opacity: 0;
        transition: opacity 0.6s 0.3s;
      }
      .cinema.show .cinema-body { opacity: 1; }
      .cinema-title {
        margin: 0;
        font-size: clamp(2rem, 5vw, 3.2rem);
        font-weight: 700;
        color: var(--sun);
        -webkit-text-stroke: 2px var(--ink);
        paint-order: stroke fill;
        text-shadow: 4px 4px 0 var(--ink);
      }
      .cinema-sub { margin: 0; font-weight: 600; }

      /* 门前的擦除转场：墨色的一道色块从左扫到右，中途切换到作品区。 */
      .wipe {
        position: fixed;
        inset: 0;
        z-index: 90;
        background: var(--ink);
        transform: translateX(-101%);
        pointer-events: none;
      }
      .wipe.run { animation: wipe 0.75s var(--ease) forwards; }
      @keyframes wipe {
        0% { transform: translateX(-101%); }
        50% { transform: translateX(0); }
        100% { transform: translateX(101%); }
      }

      /* 标题的故障闪烁：短促的红青色错位，只在门开时出现一次。 */
      .title.glitch { animation: glitch 0.6s steps(2) 3; }
      @keyframes glitch {
        0% { text-shadow: 5px 5px 0 var(--ink); }
        25% { text-shadow: -4px 0 0 #ff6b6b, 4px 2px 0 #5ee6b8, 5px 5px 0 var(--ink); transform: translateX(-3px); }
        50% { text-shadow: 6px -2px 0 #9b7bff, 5px 5px 0 var(--ink); transform: translateX(3px); }
        75% { text-shadow: -2px 3px 0 #5ee6b8, 5px 5px 0 var(--ink); transform: none; }
        100% { text-shadow: 5px 5px 0 var(--ink); }
      }

      .touch { display: none; margin-top: 16px; justify-content: space-between; align-items: center; }
      @media (pointer: coarse) { .touch { display: flex; } }
      .dpad { display: grid; grid-template-columns: repeat(3, 58px); grid-template-rows: repeat(2, 58px); gap: 8px; }
      .dpad [data-dir="up"] { grid-column: 2; grid-row: 1; }
      .dpad [data-dir="left"] { grid-column: 1; grid-row: 2; }
      .dpad [data-dir="right"] { grid-column: 3; grid-row: 2; }
      .dpad [data-dir="down"] { grid-column: 2; grid-row: 2; }
      .touch button {
        border: 3px solid var(--ink);
        border-radius: 16px;
        background: var(--cream);
        color: var(--ink);
        font: inherit;
        font-size: 1.1rem;
        box-shadow: 4px 4px 0 var(--ink);
        touch-action: none;
      }
      .touch button:active { transform: translate(3px, 3px); box-shadow: 1px 1px 0 var(--ink); }
      .action {
        width: 90px;
        height: 90px;
        border-radius: 50% !important;
        background: var(--mint) !important;
        font-weight: 700 !important;
        font-size: 1.4rem !important;
      }

      /* 笔记：一张贴着纸胶带的便签。 */
      .notes {
        position: relative;
        padding: 24px 22px 22px;
        background: var(--cream);
        border: 4px solid var(--ink);
        border-radius: 22px;
        box-shadow: 8px 8px 0 var(--ink);
        transform: rotate(1deg);
      }
      .notes::before {
        content: "";
        position: absolute;
        top: -14px;
        left: 50%;
        width: 90px;
        height: 26px;
        background: rgba(255, 210, 63, 0.85);
        border: 2px dashed var(--ink);
        transform: translateX(-50%) rotate(-3deg);
      }
      .notes-head { display: flex; align-items: center; justify-content: space-between; }
      .notes h2 { margin: 0; font-size: 1.4rem; font-weight: 700; }
      .progress {
        padding: 2px 12px;
        background: var(--mint);
        border: 2px solid var(--ink);
        border-radius: 999px;
        font-weight: 700;
        font-size: 0.95rem;
      }
      .missions { list-style: none; margin: 1.1rem 0 0; padding: 0; display: grid; gap: 12px; }
      .missions li {
        display: flex;
        gap: 12px;
        align-items: flex-start;
        padding: 12px 14px;
        background: #ffffff;
        border: 3px solid var(--ink);
        border-radius: 16px;
        box-shadow: 3px 3px 0 var(--ink);
        transition: background 0.25s;
      }
      .check {
        flex-shrink: 0;
        display: grid;
        place-items: center;
        width: 26px;
        height: 26px;
        border: 3px solid var(--ink);
        border-radius: 50%;
        background: #ffffff;
        font-size: 0.85rem;
        font-weight: 700;
        color: transparent;
      }
      .missions li.done { background: #dcfff1; }
      .missions li.done .check { background: var(--mint); color: var(--ink); }
      .m-title { margin: 0; font-weight: 600; }
      .m-count { margin-left: 6px; font-size: 0.85rem; font-weight: 500; color: var(--blue); }
      .m-summary { margin: 0.3rem 0 0; font-size: 0.92rem; }
      .reset {
        margin-top: 18px;
        padding: 8px 16px;
        border: 3px solid var(--ink);
        border-radius: 999px;
        background: var(--pink);
        color: var(--ink);
        font: inherit;
        font-weight: 600;
        box-shadow: 3px 3px 0 var(--ink);
        cursor: pointer;
      }
      .reset:hover { transform: translate(-1px, -1px); }
      .fallback { font-weight: 500; }

      /* ---------- 跑马灯 ---------- */
      .marquee {
        overflow: hidden;
        margin: 30px 0;
        padding: 14px 0;
        background: var(--ink);
        transform: rotate(-1.5deg);
        -webkit-mask-image: linear-gradient(90deg, transparent, #000 6%, #000 94%, transparent);
        mask-image: linear-gradient(90deg, transparent, #000 6%, #000 94%, transparent);
      }
      .marquee-track { display: flex; gap: 18px; width: max-content; animation: marquee 30s linear infinite; }
      .marquee:hover .marquee-track { animation-play-state: paused; }
      .chip { display: inline-flex; align-items: center; gap: 18px; font-size: 1.1rem; font-weight: 600; color: var(--cream); white-space: nowrap; }
      .sep { color: var(--sun); }
      @keyframes marquee { to { transform: translateX(-50%); } }

      /* ---------- 通用段落 ---------- */
      .section {
        max-width: 1120px;
        margin: 0 auto;
        padding: clamp(60px, 10vh, 110px) clamp(18px, 5vw, 40px) 0;
        opacity: 0;
        transform: translateY(30px) rotate(-0.5deg);
        transition: opacity 0.7s var(--ease), transform 0.7s var(--ease);
      }
      .section.in { opacity: 1; transform: none; }
      .section-head h2 {
        margin: 0.7rem 0 0;
        font-size: clamp(2.2rem, 5vw, 3.4rem);
        font-weight: 700;
        line-height: 1.05;
        -webkit-text-stroke: 1.5px var(--ink);
        paint-order: stroke fill;
        text-shadow: 3px 3px 0 var(--pink);
      }
      .repo-intro, .studio-intro { max-width: 60ch; margin: 0.8rem 0 0; font-size: 1.05rem; font-weight: 500; }
      .repo-intro a { font-weight: 700; }

      /* ---------- Bento 作品网格 ---------- */
      .bento {
        margin-top: 2.4rem;
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        grid-auto-rows: minmax(230px, auto);
        gap: 24px;
      }
      .tile {
        position: relative;
        display: flex;
        flex-direction: column;
        overflow: hidden;
        padding: 24px;
        background:
          radial-gradient(circle at var(--mx, 90%) var(--my, 8%), color-mix(in srgb, var(--accent) 45%, transparent), transparent 42%),
          var(--cream);
        border: 4px solid var(--ink);
        border-radius: 26px;
        box-shadow: var(--pop);
        text-decoration: none;
        transition: transform 0.2s var(--ease), box-shadow 0.2s;
      }
      .tile:hover { transform: translate(-3px, -3px) rotate(-0.6deg); box-shadow: 10px 10px 0 var(--ink); }
      .tile-wide { grid-column: span 2; grid-row: span 2; padding: 34px; }
      .tile-glyph {
        position: absolute;
        right: -14px;
        top: -14px;
        width: 140px;
        height: 140px;
        fill: none;
        stroke: var(--ink);
        stroke-width: 2.4;
        opacity: 0.25;
        transition: transform 0.6s var(--ease);
      }
      .tile:not(.tile-wide) .tile-glyph { top: auto; bottom: -30px; right: -30px; }
      .tile-wide .tile-glyph { width: 320px; height: 320px; right: -60px; top: -50px; opacity: 0.18; }
      .tile:hover .tile-glyph { transform: rotate(30deg) scale(1.06); }
      .tile-top { display: flex; justify-content: space-between; align-items: center; position: relative; }
      .tile-index { font-weight: 700; font-size: 1.1rem; }
      .tile-lang {
        padding: 3px 12px;
        background: var(--accent);
        border: 3px solid var(--ink);
        border-radius: 999px;
        font-size: 0.85rem;
        font-weight: 700;
      }
      .tile-name { margin: auto 0 0.4rem; padding-top: 2rem; font-size: clamp(1.5rem, 2.6vw, 1.9rem); font-weight: 700; position: relative; }
      .tile-wide .tile-name { font-size: clamp(2.3rem, 4.8vw, 3.8rem); }
      .tile-blurb { margin: 0 0 1.2rem; font-size: 1rem; max-width: 46ch; position: relative; }
      .tile-foot { display: flex; justify-content: space-between; align-items: center; font-weight: 600; position: relative; }
      .tile-open span { display: inline-block; transition: transform 0.2s var(--ease); }
      .tile:hover .tile-open span { transform: translate(3px, -3px); }

      /* ---------- 仓库页 ---------- */
      .repo-controls { display: flex; flex-wrap: wrap; align-items: center; gap: 12px; margin-top: 1.8rem; }
      .repo-controls input[type="search"], .repo-controls select {
        padding: 10px 14px;
        border: 3px solid var(--ink);
        border-radius: 14px;
        background: var(--cream);
        color: var(--ink);
        font: inherit;
        box-shadow: 3px 3px 0 var(--ink);
      }
      .repo-controls input[type="search"] { flex: 1 1 260px; }
      .toggle { display: inline-flex; align-items: center; gap: 6px; font-weight: 600; }
      .repo-status { margin: 1rem 0 0; font-weight: 600; }
      .repo-grid {
        list-style: none;
        margin: 1.1rem 0 0;
        padding: 0;
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
        gap: 18px;
      }
      .repo-link {
        display: flex;
        flex-direction: column;
        gap: 0.6rem;
        height: 100%;
        padding: 18px;
        background: var(--cream);
        border: 3px solid var(--ink);
        border-radius: 20px;
        box-shadow: 5px 5px 0 var(--ink);
        text-decoration: none;
        transition: transform 0.15s var(--ease), box-shadow 0.15s;
      }
      .repo-link:hover { transform: translate(-2px, -2px); box-shadow: 7px 7px 0 var(--ink); }
      .repo-head { display: flex; flex-wrap: wrap; gap: 6px; align-items: center; }
      .repo-name { font-weight: 700; word-break: break-word; }
      .repo-badge { font-size: 0.72rem; font-weight: 700; padding: 2px 8px; background: var(--sun); border: 2px solid var(--ink); border-radius: 999px; }
      .repo-badge-fork { background: #ffffff; }
      .repo-desc { margin: 0; flex: 1; font-size: 0.92rem; color: #3d3556; }
      .repo-foot { display: flex; flex-wrap: wrap; gap: 10px; align-items: center; font-size: 0.82rem; font-weight: 600; }
      .repo-lang { display: inline-flex; align-items: center; gap: 4px; }
      .repo-dot { display: inline-block; width: 10px; height: 10px; border-radius: 50%; border: 2px solid var(--ink); }
      .repo-date { margin-left: auto; font-weight: 500; color: #3d3556; }
      .repo-topics { display: flex; flex-wrap: wrap; gap: 6px; }
      .repo-topic { font-size: 0.72rem; padding: 2px 8px; background: var(--mint); border: 2px solid var(--ink); border-radius: 999px; }

      /* ---------- 工作室 ---------- */
      .gallery { margin-top: 2.4rem; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 22px; }
      button.art {
        position: relative;
        display: block;
        padding: 0;
        aspect-ratio: 1;
        overflow: hidden;
        background: #ffffff;
        border: 4px solid var(--ink);
        border-radius: 22px;
        box-shadow: var(--pop);
        cursor: zoom-in;
        font: inherit;
        color: inherit;
        transition: transform 0.2s var(--ease);
      }
      button.art:hover { transform: rotate(-1.5deg) scale(1.02); }
      button.art.art-feature { grid-column: span 2; aspect-ratio: 2 / 1; }
      .art img { display: block; width: 100%; height: 100%; object-fit: cover; }
      .art-feature img { object-position: 50% 62%; }
      .art-cap {
        position: absolute;
        left: 14px;
        bottom: 14px;
        display: flex;
        flex-direction: column;
        padding: 4px 12px;
        background: var(--cream);
        border: 3px solid var(--ink);
        border-radius: 12px;
        text-align: left;
        opacity: 0;
        transform: translateY(6px);
        transition: opacity 0.2s, transform 0.2s var(--ease);
      }
      button.art:hover .art-cap, button.art:focus-visible .art-cap { opacity: 1; transform: none; }
      .art-title { font-weight: 700; }
      .art-note { font-size: 0.8rem; font-weight: 500; }

      .lightbox {
        width: min(92vw, 900px);
        padding: 0;
        border: 4px solid var(--ink);
        border-radius: 22px;
        background: var(--cream);
        box-shadow: 10px 10px 0 var(--ink);
        color: var(--ink);
      }
      .lightbox::backdrop { background: rgba(29, 20, 51, 0.6); }
      .lightbox img { display: block; width: 100%; max-height: 66vh; object-fit: contain; background: #07070b; border-bottom: 4px solid var(--ink); }
      .lightbox-body { padding: 16px 22px 20px; }
      .lightbox-title { margin: 0; font-size: 1.5rem; font-weight: 700; }
      .lightbox-note { margin: 0.2rem 0 0; font-weight: 600; color: var(--blue); }
      .lightbox-how { margin: 0.8rem 0 0; font-size: 1rem; }

      /* ---------- 关于 ---------- */
      .statement {
        margin: 1.8rem 0 0;
        max-width: 24ch;
        font-size: clamp(2rem, 5vw, 3.6rem);
        line-height: 1.12;
        font-weight: 600;
      }
      .statement mark {
        padding: 0 8px;
        background: var(--mint);
        border: 3px solid var(--ink);
        border-radius: 12px;
        color: var(--ink);
      }
      .stats { display: grid; grid-template-columns: repeat(auto-fit, minmax(170px, 1fr)); gap: 22px; margin: 2.4rem 0 0; padding: 0; }
      .stats div {
        padding: 22px;
        border: 4px solid var(--ink);
        border-radius: 24px;
        box-shadow: var(--pop);
      }
      .stat-a { background: var(--sun); }
      .stat-b { background: var(--pink); }
      .stat-c { background: var(--mint); }
      .stats dt { font-size: 0.95rem; font-weight: 600; }
      .stats dd { margin: 0.2rem 0 0; font-size: clamp(2.4rem, 5vw, 3.2rem); font-weight: 700; line-height: 1; font-variant-numeric: tabular-nums; }
      .about-links { display: flex; gap: 16px; margin-top: 2.2rem; }
      .about-links a {
        padding: 10px 20px;
        background: var(--cream);
        border: 3px solid var(--ink);
        border-radius: 999px;
        box-shadow: 3px 3px 0 var(--ink);
        font-weight: 600;
        text-decoration: none;
        transition: transform 0.12s var(--ease);
      }
      .about-links a:hover { transform: translate(-2px, -2px); }

      /* ---------- 页脚 ---------- */
      .footer {
        max-width: 1120px;
        margin: clamp(90px, 14vh, 160px) auto 0;
        padding: 0 clamp(18px, 5vw, 40px) 40px;
        overflow: hidden;
      }
      .giant {
        font-size: clamp(4.5rem, 19vw, 15rem);
        font-weight: 700;
        line-height: 0.85;
        color: var(--sun);
        -webkit-text-stroke: 4px var(--ink);
        paint-order: stroke fill;
        text-shadow: 10px 10px 0 var(--ink);
        white-space: nowrap;
        user-select: none;
      }
      .footer-row {
        display: flex;
        justify-content: space-between;
        flex-wrap: wrap;
        gap: 10px;
        margin-top: 30px;
        padding: 14px 20px;
        background: var(--cream);
        border: 3px solid var(--ink);
        border-radius: 999px;
        font-weight: 500;
      }

      @media (max-width: 900px) {
        .quest-layout { grid-template-columns: 1fr; }
        .bento { grid-template-columns: repeat(2, minmax(0, 1fr)); grid-auto-rows: auto; }
        .tile-wide { grid-row: auto; }
        .gallery { grid-template-columns: repeat(2, minmax(0, 1fr)); }
      }
      @media (max-width: 600px) {
        .nav-links a:not(.nav-cta) { display: none; }
        .bento { grid-template-columns: 1fr; }
        .tile-wide { grid-column: auto; }
        .tile-wide .tile-glyph { width: 200px; height: 200px; }
        .gallery { grid-template-columns: 1fr; }
        button.art.art-feature { grid-column: auto; aspect-ratio: 1; }
        .dialog { left: 12px; right: 12px; bottom: 14px; padding: 12px 14px; }
        .game { box-shadow: 6px 6px 0 var(--ink); }
        .repo-grid { grid-template-columns: 1fr; }
      }

      @media (prefers-reduced-motion: reduce) {
        html { scroll-behavior: auto; }
        .marquee-track { animation: none !important; }
        .section { transition: none !important; opacity: 1; transform: none; }
        .wipe.run { animation: none; }
      }
    </style>
  </body>
</html>
