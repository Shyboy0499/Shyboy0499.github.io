---
// 站点唯一页面：顶部是 2D 像素房间的任务式入口，下方是作品、视觉作品与关于。
// 页面只负责结构与样式；游戏运行时在 scripts/quest.ts，数据在 content/*.ts。
import { profile, projects } from "../content/projects";
import { artworks } from "../content/gallery";
import { missions } from "../content/missions";

const year = new Date().getFullYear();
// 统计数字由作品数据推导，避免与列表不一致。
const totalStars = projects.reduce((sum, p) => sum + Number(p.stars), 0);
const languageCount = new Set(projects.map((p) => p.lang)).size;
const keywords = ["TypeScript", "Python", "Swift", "AI agents", "Git automation", "Program synthesis", "LLM tooling", "Open source"];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{profile.name} — {profile.handle}</title>
    <meta name="description" content={profile.blurb} />
    <meta property="og:title" content={profile.name} />
    <meta property="og:description" content={profile.blurb} />
    <meta property="og:type" content="website" />
    <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'%3E%3Ctext y='.9em' font-size='90'%3E%E2%9C%A6%3C/text%3E%3C/svg%3E" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <nav class="nav">
      <a class="brand" href="#top"><span class="brand-mark">✦</span> {profile.name}</a>
      <div class="nav-links">
        <a href="#quest">Play</a>
        <a href="#work">Work</a>
        <a href="#studio">Studio</a>
        <a href="#about">About</a>
        <a class="nav-cta" href={profile.github} target="_blank" rel="noopener noreferrer">GitHub ↗</a>
      </div>
    </nav>

    <main id="top">
      <!-- 2D 任务式入口：房间里的物件各自揭示一段信息，四个任务全部完成后打开大门。 -->
      <section id="quest" class="quest" aria-labelledby="quest-title">
        <header class="quest-head">
          <p class="kicker">{profile.handle} · a quest intro</p>
          <h1 id="quest-title" class="title">{profile.name}</h1>
          <p class="lede">{profile.blurb}</p>
        </header>

        <div class="quest-layout">
          <div class="stage">
            <canvas class="game" data-canvas tabindex="0" role="img" aria-label="A small pixel room. Walk with the arrow keys or WASD, press E to read an object. Finish the four missions to open the gate to the portfolio."></canvas>

            <div class="start">
              <button class="btn" type="button" data-start>Start quest</button>
              <p class="start-hint">Arrow keys or WASD to walk · E to interact</p>
            </div>

            <div class="dialog" data-dialog hidden>
              <p class="dialog-title" data-dialog-title></p>
              <p class="dialog-text" data-dialog-text></p>
              <p class="dialog-next">▸ E / tap to continue</p>
            </div>

            <p class="hud-hint" data-hint aria-live="polite"></p>

            <div class="touch">
              <div class="dpad">
                <button type="button" data-dir="up" aria-label="Walk up">▲</button>
                <button type="button" data-dir="left" aria-label="Walk left">◀</button>
                <button type="button" data-dir="right" aria-label="Walk right">▶</button>
                <button type="button" data-dir="down" aria-label="Walk down">▼</button>
              </div>
              <button class="action" type="button" data-action aria-label="Interact">E</button>
            </div>
          </div>

          <aside class="notes" aria-label="Field notes">
            <div class="notes-head">
              <h2>Field notes</h2>
              <span class="progress" data-progress>0 / {missions.length}</span>
            </div>
            <ol class="missions">
              {
                missions.map((m) => (
                  <li data-mission={m.id}>
                    <span class="check" aria-hidden="true"></span>
                    <div>
                      <p class="m-title">
                        {m.title}
                        <span class="m-count" data-count></span>
                      </p>
                      <p class="m-summary" data-summary hidden></p>
                    </div>
                  </li>
                ))
              }
            </ol>
            <button class="reset" type="button" data-reset>Reset progress</button>
          </aside>
        </div>

        <noscript>
          <style>.stage, .notes { display: none; }</style>
          <p class="fallback">Scripts are off, so the quest is hidden. Everything it reveals is in the sections below.</p>
        </noscript>
      </section>

      <div class="marquee" aria-hidden="true">
        <div class="marquee-track">
          {[...keywords, ...keywords].map((k) => <span class="chip">{k}<span class="sep">✦</span></span>)}
        </div>
      </div>

      <!-- 作品：Bento 网格，首张大卡片；指针在卡片上移动时点亮高光。 -->
      <section id="work" class="section" data-reveal>
        <header class="section-head">
          <p class="kicker">01 — Work</p>
          <h2>Selected projects</h2>
        </header>
        <div class="bento">
          {
            projects.map((p, i) => (
              <a
                class={`tile${i === 0 ? " tile-wide" : ""}`}
                href={p.href}
                target="_blank"
                rel="noopener noreferrer"
                style={`--accent:${p.accent}`}
              >
                <svg class="tile-glyph" viewBox="0 0 100 100" aria-hidden="true">
                  <polygon points="50,6 92,38 50,94 8,38" />
                  <polyline points="8,38 50,50 92,38" />
                  <line x1="50" y1="6" x2="50" y2="50" />
                  <line x1="50" y1="50" x2="50" y2="94" />
                </svg>
                <div class="tile-top">
                  <span class="tile-index">0{i + 1}</span>
                  <span class="tile-lang">{p.lang}</span>
                </div>
                <h3 class="tile-name">{p.name}</h3>
                <p class="tile-blurb">{p.blurb}</p>
                <div class="tile-foot">
                  <span class="tile-star">★ {p.stars}</span>
                  <span class="tile-open">Open repository <span aria-hidden="true">↗</span></span>
                </div>
              </a>
            ))
          }
        </div>
      </section>

      <!-- 视觉作品：第一张为照片的大图，其余为生成艺术；图片数据见 content/gallery.ts。 -->
      <section id="studio" class="section" data-reveal>
        <header class="section-head">
          <p class="kicker">02 — Studio</p>
          <h2>Pictures and experiments</h2>
        </header>
        <div class="gallery">
          {
            artworks.map((a, i) => (
              <figure class={`art${i === 0 ? " art-feature" : ""}`}>
                <img src={a.src} alt={a.alt} loading="lazy" decoding="async" />
                <figcaption>
                  <span class="art-title">{a.title}</span>
                  <span class="art-note">{a.note}</span>
                </figcaption>
              </figure>
            ))
          }
        </div>
      </section>

      <section id="about" class="section about" data-reveal>
        <header class="section-head">
          <p class="kicker">03 — About</p>
        </header>
        <p class="statement">
          I build tools that <em>check their own work</em>: agents, git automation, and the
          Mac setups that make a machine feel like mine.
        </p>
        <dl class="stats">
          <div><dt>Projects</dt><dd>{projects.length}</dd></div>
          <div><dt>GitHub stars</dt><dd>{totalStars}</dd></div>
          <div><dt>Languages</dt><dd>{languageCount}</dd></div>
        </dl>
        <div class="about-links">
          <a href={profile.github} target="_blank" rel="noopener noreferrer">GitHub ↗</a>
          <a href={`mailto:${profile.email}`}>Email ↗</a>
        </div>
      </section>

      <footer class="footer">
        <div class="giant" aria-hidden="true">Chris Yu</div>
        <div class="footer-row">
          <span>✦ {profile.name} · {profile.handle}</span>
          <span class="muted">© {year} · Built with care</span>
        </div>
      </footer>
    </main>

    <script>
      import { mountQuest } from "../scripts/quest";

      const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

      const quest = document.getElementById("quest");
      if (quest) mountQuest(quest);

      // 作品卡片：指针位置写入 CSS 变量，驱动高光跟随。
      document.querySelectorAll<HTMLElement>(".tile").forEach((tile) => {
        tile.addEventListener("pointermove", (e) => {
          const r = tile.getBoundingClientRect();
          tile.style.setProperty("--mx", `${e.clientX - r.left}px`);
          tile.style.setProperty("--my", `${e.clientY - r.top}px`);
        });
      });

      // 段落进入视口时淡入上浮。
      const revealEls = document.querySelectorAll<HTMLElement>("[data-reveal]");
      if (reduce) {
        revealEls.forEach((el) => el.classList.add("in"));
      } else {
        const io = new IntersectionObserver(
          (entries) => {
            for (const en of entries) {
              if (en.isIntersecting) {
                en.target.classList.add("in");
                io.unobserve(en.target);
              }
            }
          },
          { threshold: 0.12 },
        );
        revealEls.forEach((el) => io.observe(el));
      }
    </script>

    <style is:global>
      :root {
        --bg: #07070b;
        --fg: #ecedf2;
        --muted: #9a9bab;
        --line: rgba(255, 255, 255, 0.09);
        --card: rgba(255, 255, 255, 0.03);
        --c1: #7c5cff;
        --c2: #36d6c3;
        --c3: #ff7a59;
        --sans: "Space Grotesk", system-ui, sans-serif;
        --mono: "JetBrains Mono", ui-monospace, monospace;
        --ease: cubic-bezier(0.2, 0.8, 0.2, 1);
      }

      * { box-sizing: border-box; }
      html { scroll-behavior: smooth; }
      body {
        margin: 0;
        background: var(--bg);
        color: var(--fg);
        font-family: var(--sans);
        line-height: 1.6;
        overflow-x: hidden;
        -webkit-font-smoothing: antialiased;
      }
      a { color: inherit; }
      [hidden] { display: none !important; }
      :focus-visible { outline: 2px solid var(--c2); outline-offset: 3px; }
      .muted { color: var(--muted); }
      .kicker { font-family: var(--mono); font-size: 0.75rem; letter-spacing: 0.16em; text-transform: uppercase; color: var(--c2); margin: 0; }

      /* ---------- 导航 ---------- */
      .nav {
        position: fixed;
        top: 0; left: 0; right: 0;
        z-index: 20;
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 18px clamp(20px, 5vw, 56px);
        pointer-events: none;
        background: linear-gradient(to bottom, rgba(7, 7, 11, 0.8), transparent);
      }
      .nav > * { pointer-events: auto; }
      .brand { font-weight: 600; text-decoration: none; }
      .brand-mark { color: var(--c1); }
      .nav-links { display: flex; align-items: center; gap: clamp(12px, 2.4vw, 26px); font-size: 0.92rem; }
      .nav-links a:not(.nav-cta) { text-decoration: none; color: var(--muted); transition: color 0.2s; }
      .nav-links a:not(.nav-cta):hover { color: var(--fg); }
      .nav-cta {
        padding: 7px 15px;
        border: 1px solid var(--line);
        border-radius: 999px;
        text-decoration: none;
        background: rgba(7, 7, 11, 0.5);
        backdrop-filter: blur(8px);
        transition: border-color 0.2s, background 0.2s;
      }
      .nav-cta:hover { border-color: var(--c2); background: rgba(54, 214, 195, 0.08); }

      main { margin: 0 auto; }

      /* ---------- 2D 任务入口 ---------- */
      .quest {
        max-width: 1180px;
        margin: 0 auto;
        padding: 120px clamp(20px, 5vw, 40px) 40px;
        background: radial-gradient(ellipse at 30% 0%, #17102e 0%, var(--bg) 60%);
      }
      .title {
        margin: 0.4rem 0 0;
        font-size: clamp(2.8rem, 8vw, 5.4rem);
        line-height: 0.95;
        font-weight: 700;
        letter-spacing: -0.04em;
        background: linear-gradient(100deg, var(--c1), var(--c2) 55%, var(--c3));
        -webkit-background-clip: text;
        background-clip: text;
        color: transparent;
      }
      .lede { color: var(--muted); margin: 0.9rem 0 0; max-width: 56ch; font-size: clamp(0.98rem, 2vw, 1.08rem); }

      .quest-layout {
        margin-top: 2rem;
        display: grid;
        grid-template-columns: minmax(0, 1fr) 300px;
        gap: 22px;
        align-items: start;
      }
      .stage { position: relative; }
      .game {
        display: block;
        width: 100%;
        height: auto;
        aspect-ratio: 24 / 14;
        image-rendering: pixelated;
        border: 1px solid var(--line);
        border-radius: 18px;
        background: #07070b;
        box-shadow: 0 30px 80px -40px rgba(124, 92, 255, 0.5);
      }
      .start {
        position: absolute;
        inset: 0;
        display: grid;
        place-content: center;
        justify-items: center;
        gap: 14px;
        border-radius: 18px;
        background: rgba(7, 7, 11, 0.7);
        backdrop-filter: blur(4px);
      }
      .is-started .start { display: none; }
      .start-hint { margin: 0; font-family: var(--mono); font-size: 0.78rem; color: var(--muted); }
      .btn {
        padding: 13px 30px;
        border: 0;
        border-radius: 999px;
        font: inherit;
        font-weight: 600;
        color: #06060a;
        background: linear-gradient(100deg, var(--c1), var(--c2));
        box-shadow: 0 12px 34px -12px rgba(124, 92, 255, 0.8);
        cursor: pointer;
        transition: transform 0.18s ease;
      }
      .btn:hover { transform: translateY(-2px); }

      .dialog {
        position: absolute;
        left: 16px;
        right: 16px;
        bottom: 16px;
        padding: 16px 20px;
        border: 1px solid var(--c2);
        border-radius: 14px;
        background: rgba(10, 10, 16, 0.94);
        box-shadow: 0 0 30px -10px var(--c2);
      }
      .dialog-title { margin: 0; font-family: var(--mono); font-size: 0.78rem; letter-spacing: 0.08em; text-transform: uppercase; color: var(--c2); }
      .dialog-text { margin: 0.4rem 0 0; min-height: 3em; font-size: 1rem; }
      .dialog-next { margin: 0.5rem 0 0; font-family: var(--mono); font-size: 0.72rem; color: var(--muted); }

      .hud-hint {
        position: absolute;
        top: 14px;
        left: 14px;
        margin: 0;
        padding: 5px 12px;
        border: 1px solid var(--line);
        border-radius: 999px;
        background: rgba(7, 7, 11, 0.75);
        font-family: var(--mono);
        font-size: 0.76rem;
        pointer-events: none;
      }
      .hud-hint:empty { display: none; }

      .touch { display: none; margin-top: 14px; justify-content: space-between; align-items: center; }
      @media (pointer: coarse) { .touch { display: flex; } }
      .dpad { display: grid; grid-template-columns: repeat(3, 56px); grid-template-rows: repeat(2, 56px); gap: 8px; }
      .dpad [data-dir="up"] { grid-column: 2; grid-row: 1; }
      .dpad [data-dir="left"] { grid-column: 1; grid-row: 2; }
      .dpad [data-dir="right"] { grid-column: 3; grid-row: 2; }
      .dpad [data-dir="down"] { grid-column: 2; grid-row: 2; }
      .touch button {
        border: 1px solid var(--line);
        border-radius: 14px;
        background: var(--card);
        color: var(--fg);
        font: inherit;
        touch-action: none;
      }
      .action {
        width: 84px;
        height: 84px;
        border-radius: 50% !important;
        border-color: var(--c2) !important;
        color: var(--c2);
        font-family: var(--mono);
        font-weight: 600;
      }

      .notes {
        padding: 22px;
        border: 1px solid var(--line);
        border-radius: 22px;
        background: var(--card);
      }
      .notes-head { display: flex; align-items: baseline; justify-content: space-between; }
      .notes h2 { margin: 0; font-size: 1.2rem; letter-spacing: -0.01em; }
      .progress { font-family: var(--mono); font-size: 0.82rem; color: var(--c2); }
      .missions { list-style: none; margin: 1.1rem 0 0; padding: 0; display: grid; gap: 10px; }
      .missions li {
        display: flex;
        gap: 12px;
        padding: 14px;
        border: 1px solid var(--line);
        border-radius: 16px;
        background: rgba(255, 255, 255, 0.02);
        transition: border-color 0.3s, background 0.3s;
      }
      .missions li.done { border-color: color-mix(in srgb, var(--c2) 45%, transparent); background: color-mix(in srgb, var(--c2) 6%, transparent); }
      .check {
        flex-shrink: 0;
        width: 13px;
        height: 13px;
        margin-top: 5px;
        border: 1px solid var(--muted);
        border-radius: 3px;
        transition: background 0.3s, box-shadow 0.3s;
      }
      .done .check { background: var(--c2); border-color: var(--c2); box-shadow: 0 0 10px var(--c2); }
      .m-title { margin: 0; font-weight: 600; }
      .m-count { margin-left: 6px; font-family: var(--mono); font-size: 0.72rem; font-weight: 400; color: var(--muted); }
      .m-summary { margin: 0.3rem 0 0; font-size: 0.9rem; color: var(--muted); }
      .reset {
        margin-top: 16px;
        padding: 8px 14px;
        border: 1px solid var(--line);
        border-radius: 999px;
        background: transparent;
        color: var(--muted);
        font: inherit;
        font-size: 0.82rem;
        cursor: pointer;
      }
      .reset:hover { color: var(--fg); border-color: var(--fg); }
      .fallback { color: var(--muted); }

      /* ---------- 跑马灯 ---------- */
      .marquee {
        overflow: hidden;
        border-block: 1px solid var(--line);
        background: rgba(255, 255, 255, 0.015);
        padding: 16px 0;
        -webkit-mask-image: linear-gradient(90deg, transparent, #000 8%, #000 92%, transparent);
        mask-image: linear-gradient(90deg, transparent, #000 8%, #000 92%, transparent);
      }
      .marquee-track { display: flex; gap: 14px; width: max-content; animation: marquee 34s linear infinite; }
      .marquee:hover .marquee-track { animation-play-state: paused; }
      .chip { display: inline-flex; align-items: center; gap: 14px; font-family: var(--mono); font-size: 0.85rem; color: var(--muted); white-space: nowrap; }
      .sep { color: var(--c2); font-size: 0.7rem; }
      @keyframes marquee { to { transform: translateX(-50%); } }

      /* ---------- 通用段落 ---------- */
      .section {
        max-width: 1120px;
        margin: 0 auto;
        padding: clamp(80px, 13vh, 150px) clamp(20px, 5vw, 40px) 0;
        opacity: 0;
        transform: translateY(40px);
        transition: opacity 1s var(--ease), transform 1s var(--ease);
      }
      .section.in { opacity: 1; transform: none; }
      .section-head h2 { margin: 0.5rem 0 0; font-size: clamp(2rem, 5vw, 3.2rem); line-height: 1.05; letter-spacing: -0.03em; }

      /* ---------- Bento 作品网格 ---------- */
      .bento {
        margin-top: 2.6rem;
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        grid-auto-rows: minmax(230px, auto);
        gap: 18px;
      }
      .tile {
        position: relative;
        display: flex;
        flex-direction: column;
        overflow: hidden;
        padding: 26px;
        border: 1px solid var(--line);
        border-radius: 24px;
        background:
          radial-gradient(circle at var(--mx, 85%) var(--my, 10%), color-mix(in srgb, var(--accent) 26%, transparent), transparent 55%),
          var(--card);
        text-decoration: none;
        transition: transform 0.35s var(--ease), border-color 0.35s;
      }
      .tile:hover { transform: translateY(-5px); border-color: color-mix(in srgb, var(--accent) 60%, transparent); }
      .tile-wide { grid-column: span 2; grid-row: span 2; padding: 34px; }
      .tile-glyph {
        position: absolute;
        right: -10px;
        top: -10px;
        width: 150px;
        height: 150px;
        fill: none;
        stroke: var(--accent);
        stroke-width: 1.2;
        opacity: 0.35;
        transition: transform 0.8s var(--ease), opacity 0.4s;
      }
      /* 小卡片的图形放到右下角，避免压住右上角的语言标签。 */
      .tile:not(.tile-wide) .tile-glyph { top: auto; bottom: -34px; right: -34px; }
      .tile-wide .tile-glyph { width: 340px; height: 340px; right: -60px; top: -40px; opacity: 0.22; }
      .tile:hover .tile-glyph { transform: rotate(40deg) scale(1.05); opacity: 0.6; }
      .tile-top { display: flex; justify-content: space-between; align-items: center; position: relative; }
      .tile-index { font-family: var(--mono); font-size: 0.78rem; color: var(--muted); }
      .tile-lang {
        font-family: var(--mono);
        font-size: 0.72rem;
        padding: 4px 10px;
        border: 1px solid color-mix(in srgb, var(--accent) 50%, transparent);
        border-radius: 999px;
        color: var(--accent);
      }
      .tile-name { margin: auto 0 0.5rem; padding-top: 2rem; font-size: clamp(1.4rem, 2.4vw, 1.7rem); font-weight: 600; letter-spacing: -0.02em; position: relative; }
      .tile-wide .tile-name { font-size: clamp(2.2rem, 4.6vw, 3.6rem); letter-spacing: -0.035em; }
      .tile-blurb { color: var(--muted); margin: 0 0 1.4rem; font-size: 0.96rem; max-width: 46ch; position: relative; }
      .tile-foot { display: flex; justify-content: space-between; align-items: center; font-family: var(--mono); font-size: 0.8rem; position: relative; }
      .tile-star { color: var(--muted); }
      .tile-open span { display: inline-block; transition: transform 0.25s var(--ease); }
      .tile:hover .tile-open span { transform: translate(3px, -3px); }

      /* ---------- 视觉作品 ---------- */
      .gallery { margin-top: 2.6rem; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 16px; }
      .art { position: relative; margin: 0; aspect-ratio: 1; overflow: hidden; border: 1px solid var(--line); border-radius: 20px; background: var(--card); }
      .art-feature { grid-column: span 2; aspect-ratio: 2 / 1; }
      .art img { display: block; width: 100%; height: 100%; object-fit: cover; transition: transform 0.8s var(--ease); }
      .art-feature img { object-position: 50% 62%; }
      .art:hover img { transform: scale(1.06); }
      .art figcaption {
        position: absolute;
