---
// 站点唯一页面：顶部是卡通风格的像素房间任务入口，下方是作品、视觉作品与关于。
// 页面只负责结构与样式；游戏运行时在 scripts/quest.ts，数据在 content/*.ts。
import { profile, projects } from "../content/projects";
import { artworks } from "../content/gallery";
import { missions } from "../content/missions";

const year = new Date().getFullYear();
// 统计数字由作品数据推导，避免与列表不一致。
const totalStars = projects.reduce((sum, p) => sum + Number(p.stars), 0);
const languageCount = new Set(projects.map((p) => p.lang)).size;
const keywords = ["TypeScript", "Python", "Swift", "AI agents", "Git automation", "Program synthesis", "LLM tooling", "Open source"];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{profile.name} — {profile.handle}</title>
    <meta name="description" content={profile.blurb} />
    <meta property="og:title" content={profile.name} />
    <meta property="og:description" content={profile.blurb} />
    <meta property="og:type" content="website" />
    <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'%3E%3Ctext y='.9em' font-size='90'%3E%E2%9C%A6%3C/text%3E%3C/svg%3E" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Fredoka:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <nav class="nav">
      <a class="brand" href="#top"><span class="brand-mark">★</span> {profile.name}</a>
      <div class="nav-links">
        <a href="#quest">Play</a>
        <a href="#work">Work</a>
        <a href="#studio">Studio</a>
        <a href="#about">About</a>
        <a class="nav-cta" href={profile.github} target="_blank" rel="noopener noreferrer">GitHub ↗</a>
      </div>
    </nav>

    <main id="top">
      <!-- 任务式入口：房间里的物件各自揭示一段信息，四个任务全部完成后打开大门。 -->
      <section id="quest" class="quest" aria-labelledby="quest-title">
        <header class="quest-head">
          <p class="sticker">{profile.handle} · a quest intro</p>
          <h1 id="quest-title" class="title">{profile.name}</h1>
          <p class="lede">{profile.blurb}</p>
        </header>

        <div class="quest-layout">
          <div class="stage">
            <canvas class="game" data-canvas tabindex="0" role="img" aria-label="A small cartoon room. Walk with the arrow keys or WASD, press E to read an object. Finish the four missions to open the gate to the portfolio."></canvas>

            <div class="start">
              <button class="btn btn-big" type="button" data-start>Start quest!</button>
              <p class="start-hint">Arrow keys or WASD to walk · E to interact</p>
            </div>

            <div class="dialog" data-dialog hidden>
              <p class="dialog-title" data-dialog-title></p>
              <p class="dialog-text" data-dialog-text></p>
              <p class="dialog-next">▸ E / tap to continue</p>
            </div>

            <p class="hud-hint" data-hint aria-live="polite"></p>

            <div class="touch">
              <div class="dpad">
                <button type="button" data-dir="up" aria-label="Walk up">▲</button>
                <button type="button" data-dir="left" aria-label="Walk left">◀</button>
                <button type="button" data-dir="right" aria-label="Walk right">▶</button>
                <button type="button" data-dir="down" aria-label="Walk down">▼</button>
              </div>
              <button class="action" type="button" data-action aria-label="Interact">E</button>
            </div>
          </div>

          <aside class="notes" aria-label="Field notes">
            <div class="notes-head">
              <h2>Field notes</h2>
              <span class="progress" data-progress>0 / {missions.length}</span>
            </div>
            <ol class="missions">
              {
                missions.map((m) => (
                  <li data-mission={m.id}>
                    <span class="check" aria-hidden="true">✓</span>
                    <div>
                      <p class="m-title">
                        {m.title}
                        <span class="m-count" data-count></span>
                      </p>
                      <p class="m-summary" data-summary hidden></p>
                    </div>
                  </li>
                ))
              }
            </ol>
            <button class="reset" type="button" data-reset>Reset progress</button>
          </aside>
        </div>

        <noscript>
          <style>.stage, .notes { display: none; }</style>
          <p class="fallback">Scripts are off, so the quest is hidden. Everything it reveals is in the sections below.</p>
        </noscript>
      </section>

      <div class="marquee" aria-hidden="true">
        <div class="marquee-track">
          {[...keywords, ...keywords].map((k) => <span class="chip">{k}<span class="sep">★</span></span>)}
        </div>
      </div>

      <!-- 作品：Bento 网格，首张大卡片；指针在卡片上移动时点亮高光。 -->
      <section id="work" class="section" data-reveal>
        <header class="section-head">
          <p class="sticker">01 — Work</p>
          <h2>Selected projects</h2>
        </header>
        <div class="bento">
          {
            projects.map((p, i) => (
              <a
                class={`tile${i === 0 ? " tile-wide" : ""}`}
                href={p.href}
                target="_blank"
                rel="noopener noreferrer"
                style={`--accent:${p.accent}`}
              >
                <svg class="tile-glyph" viewBox="0 0 100 100" aria-hidden="true">
                  <polygon points="50,6 92,38 50,94 8,38" />
                  <polyline points="8,38 50,50 92,38" />
                  <line x1="50" y1="6" x2="50" y2="50" />
                  <line x1="50" y1="50" x2="50" y2="94" />
                </svg>
                <div class="tile-top">
                  <span class="tile-index">0{i + 1}</span>
                  <span class="tile-lang">{p.lang}</span>
                </div>
                <h3 class="tile-name">{p.name}</h3>
                <p class="tile-blurb">{p.blurb}</p>
                <div class="tile-foot">
                  <span class="tile-star">★ {p.stars}</span>
                  <span class="tile-open">Open repository <span aria-hidden="true">↗</span></span>
                </div>
              </a>
            ))
          }
        </div>
      </section>

      <!-- 视觉作品：第一张为照片的大图，其余为生成艺术；图片数据见 content/gallery.ts。 -->
      <section id="studio" class="section" data-reveal>
        <header class="section-head">
          <p class="sticker">02 — Studio</p>
          <h2>Pictures and experiments</h2>
        </header>
        <div class="gallery">
          {
            artworks.map((a, i) => (
              <figure class={`art${i === 0 ? " art-feature" : ""}`}>
                <img src={a.src} alt={a.alt} loading="lazy" decoding="async" />
                <figcaption>
                  <span class="art-title">{a.title}</span>
                  <span class="art-note">{a.note}</span>
                </figcaption>
              </figure>
            ))
          }
        </div>
      </section>

      <section id="about" class="section about" data-reveal>
        <header class="section-head">
          <p class="sticker">03 — About</p>
        </header>
        <p class="statement">
          I build tools that <mark>check their own work</mark>: agents, git automation, and the
          Mac setups that make a machine feel like mine.
        </p>
        <dl class="stats">
          <div class="stat-a"><dt>Projects</dt><dd>{projects.length}</dd></div>
          <div class="stat-b"><dt>GitHub stars</dt><dd>{totalStars}</dd></div>
          <div class="stat-c"><dt>Languages</dt><dd>{languageCount}</dd></div>
        </dl>
        <div class="about-links">
          <a href={profile.github} target="_blank" rel="noopener noreferrer">GitHub ↗</a>
          <a href={`mailto:${profile.email}`}>Email ↗</a>
        </div>
      </section>

      <footer class="footer">
        <div class="giant" aria-hidden="true">Chris Yu</div>
        <div class="footer-row">
          <span>★ {profile.name} · {profile.handle}</span>
          <span>© {year} · Built with care</span>
        </div>
      </footer>
    </main>

    <script>
      import { mountQuest } from "../scripts/quest";

      const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

      const quest = document.getElementById("quest");
      if (quest) mountQuest(quest);

      // 作品卡片：指针位置写入 CSS 变量，驱动高光跟随。
      document.querySelectorAll<HTMLElement>(".tile").forEach((tile) => {
        tile.addEventListener("pointermove", (e) => {
          const r = tile.getBoundingClientRect();
          tile.style.setProperty("--mx", `${e.clientX - r.left}px`);
          tile.style.setProperty("--my", `${e.clientY - r.top}px`);
        });
      });

      // 段落进入视口时弹出。
      const revealEls = document.querySelectorAll<HTMLElement>("[data-reveal]");
      if (reduce) {
        revealEls.forEach((el) => el.classList.add("in"));
      } else {
        const io = new IntersectionObserver(
          (entries) => {
            for (const en of entries) {
              if (en.isIntersecting) {
                en.target.classList.add("in");
                io.unobserve(en.target);
              }
            }
          },
          { threshold: 0.12 },
        );
        revealEls.forEach((el) => io.observe(el));
      }
    </script>

    <style is:global>
      :root {
        --sky: #9be2ff;
        --sky-light: #e9faff;
        --ink: #1d1433;
        --cream: #fff6e5;
        --sun: #ffd23f;
        --coral: #ff6b6b;
        --mint: #5ee6b8;
        --violet: #7b5cff;
        --pink: #ff9ecf;
        --blue: #3b4cca;
        --font: "Fredoka", system-ui, sans-serif;
        --pop: 6px 6px 0 var(--ink);
        --ease: cubic-bezier(0.34, 1.4, 0.64, 1);
      }

      * { box-sizing: border-box; }
      html { scroll-behavior: smooth; }
      body {
        margin: 0;
        background: linear-gradient(180deg, var(--sky) 0%, var(--sky-light) 45%, var(--sky-light) 100%);
        color: var(--ink);
        font-family: var(--font);
        font-size: 17px;
        line-height: 1.5;
        overflow-x: hidden;
      }
      a { color: inherit; }
      [hidden] { display: none !important; }
      :focus-visible { outline: 3px solid var(--violet); outline-offset: 3px; }

      /* 通用卡通部件：墨线、硬投影与圆角。 */
      .sticker {
        display: inline-block;
        margin: 0;
        padding: 4px 14px;
        background: var(--sun);
        border: 3px solid var(--ink);
        border-radius: 999px;
        box-shadow: 3px 3px 0 var(--ink);
        font-size: 0.85rem;
        font-weight: 600;
        letter-spacing: 0.02em;
        transform: rotate(-2deg);
      }
      .btn {
        display: inline-flex;
        align-items: center;
        padding: 12px 26px;
        border: 3px solid var(--ink);
        border-radius: 16px;
        background: var(--sun);
        color: var(--ink);
        font: inherit;
        font-weight: 700;
        box-shadow: var(--pop);
        cursor: pointer;
        transition: transform 0.12s var(--ease), box-shadow 0.12s;
      }
      .btn:hover { transform: translate(-2px, -2px); box-shadow: 8px 8px 0 var(--ink); }
      .btn:active { transform: translate(4px, 4px); box-shadow: 2px 2px 0 var(--ink); }
      .btn-big { font-size: 1.4rem; padding: 16px 38px; }

      /* ---------- 导航 ---------- */
      .nav {
        position: fixed;
        top: 0; left: 0; right: 0;
        z-index: 20;
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 14px clamp(16px, 4vw, 48px);
        pointer-events: none;
      }
      .nav > * { pointer-events: auto; }
      .brand {
        padding: 6px 14px;
        background: var(--cream);
        border: 3px solid var(--ink);
        border-radius: 999px;
        box-shadow: 3px 3px 0 var(--ink);
        font-weight: 700;
        text-decoration: none;
      }
      .brand-mark { color: var(--coral); }
      .nav-links {
        display: flex;
        align-items: center;
        gap: 6px;
        padding: 6px;
        background: var(--cream);
        border: 3px solid var(--ink);
        border-radius: 999px;
        box-shadow: 3px 3px 0 var(--ink);
      }
      .nav-links a:not(.nav-cta) { padding: 4px 12px; border-radius: 999px; text-decoration: none; font-weight: 500; transition: background 0.15s; }
      .nav-links a:not(.nav-cta):hover { background: var(--sky); }
      .nav-cta { padding: 5px 14px; background: var(--mint); border: 2px solid var(--ink); border-radius: 999px; text-decoration: none; font-weight: 700; }
      .nav-cta:hover { background: var(--pink); }

      main { margin: 0 auto; }

      /* ---------- 任务入口 ---------- */
      .quest {
        position: relative;
        max-width: 1180px;
        margin: 0 auto;
        padding: 120px clamp(18px, 5vw, 40px) 50px;
      }
      /* 右上角的一朵云，装饰用；放在文字区之外，避免压住介绍文字。 */
      .quest::before {
        content: "";
        position: absolute;
        top: 130px;
        right: -40px;
        width: 260px;
        height: 70px;
        pointer-events: none;
        background: #ffffff;
        border: 3px solid var(--ink);
        border-radius: 999px;
        box-shadow: 4px 4px 0 var(--ink);
        opacity: 0.9;
      }
      .title {
        position: relative;
        margin: 0.5rem 0 0;
        font-size: clamp(3.2rem, 10vw, 6.4rem);
        line-height: 0.95;
        font-weight: 700;
        color: var(--sun);
        -webkit-text-stroke: 3px var(--ink);
        paint-order: stroke fill;
        text-shadow: 5px 5px 0 var(--ink);
        letter-spacing: -0.01em;
      }
      .lede { margin: 1rem 0 0; max-width: 40ch; font-size: clamp(1.05rem, 2vw, 1.25rem); font-weight: 500; }

      .quest-layout {
        margin-top: 2.2rem;
        display: grid;
        grid-template-columns: minmax(0, 1fr) 300px;
        gap: 26px;
        align-items: start;
      }
      .stage { position: relative; }
      .game {
        display: block;
        width: 100%;
        height: auto;
        aspect-ratio: 24 / 14;
        image-rendering: pixelated;
        border: 4px solid var(--ink);
        border-radius: 22px;
        background: #f2c78a;
        box-shadow: 10px 10px 0 var(--ink);
      }
      .start {
        position: absolute;
        inset: 0;
        display: grid;
        place-content: center;
        justify-items: center;
        gap: 16px;
        border-radius: 18px;
        background: rgba(255, 246, 229, 0.82);
      }
      .is-started .start { display: none; }
      .start-hint {
        margin: 0;
        padding: 6px 14px;
        background: var(--cream);
        border: 2px solid var(--ink);
        border-radius: 999px;
        font-size: 0.95rem;
        font-weight: 500;
      }

      /* 对话气泡：墨线圆角框，底部一个小尾巴指向房间。 */
      .dialog {
        position: absolute;
        left: 22px;
        right: 22px;
        bottom: 26px;
        padding: 14px 20px 16px;
        background: var(--cream);
        border: 4px solid var(--ink);
        border-radius: 20px;
        box-shadow: 6px 6px 0 var(--ink);
      }
      .dialog::after {
        content: "";
        position: absolute;
        left: 50%;
        bottom: -18px;
        width: 22px;
        height: 22px;
        background: var(--cream);
        border-right: 4px solid var(--ink);
        border-bottom: 4px solid var(--ink);
        transform: translateX(-50%) rotate(45deg);
      }
      .dialog-title {
        display: inline-block;
        margin: 0;
        padding: 2px 12px;
        background: var(--pink);
        border: 2px solid var(--ink);
        border-radius: 999px;
        font-size: 0.9rem;
        font-weight: 700;
      }
      .dialog-text { margin: 0.5rem 0 0; min-height: 2.6em; font-size: 1.12rem; font-weight: 500; }
      .dialog-next { margin: 0.4rem 0 0; font-size: 0.85rem; font-weight: 600; color: var(--blue); }

      .hud-hint {
        position: absolute;
        top: 16px;
        left: 16px;
        margin: 0;
        padding: 5px 14px;
        background: var(--cream);
        border: 3px solid var(--ink);
        border-radius: 999px;
        box-shadow: 3px 3px 0 var(--ink);
        font-size: 0.92rem;
        font-weight: 600;
        pointer-events: none;
      }
      .hud-hint:empty { display: none; }

      .touch { display: none; margin-top: 16px; justify-content: space-between; align-items: center; }
      @media (pointer: coarse) { .touch { display: flex; } }
      .dpad { display: grid; grid-template-columns: repeat(3, 58px); grid-template-rows: repeat(2, 58px); gap: 8px; }
      .dpad [data-dir="up"] { grid-column: 2; grid-row: 1; }
      .dpad [data-dir="left"] { grid-column: 1; grid-row: 2; }
      .dpad [data-dir="right"] { grid-column: 3; grid-row: 2; }
      .dpad [data-dir="down"] { grid-column: 2; grid-row: 2; }
      .touch button {
        border: 3px solid var(--ink);
        border-radius: 16px;
        background: var(--cream);
        color: var(--ink);
        font: inherit;
        font-size: 1.1rem;
        box-shadow: 4px 4px 0 var(--ink);
        touch-action: none;
      }
      .touch button:active { transform: translate(3px, 3px); box-shadow: 1px 1px 0 var(--ink); }
      .action {
        width: 90px;
        height: 90px;
        border-radius: 50% !important;
        background: var(--mint) !important;
        font-weight: 700 !important;
        font-size: 1.4rem !important;
      }

      /* 笔记：一张贴着纸胶带的便签。 */
      .notes {
        position: relative;
        padding: 24px 22px 22px;
        background: var(--cream);
        border: 4px solid var(--ink);
        border-radius: 22px;
        box-shadow: 8px 8px 0 var(--ink);
        transform: rotate(1deg);
      }
      .notes::before {
        content: "";
        position: absolute;
        top: -14px;
        left: 50%;
        width: 90px;
        height: 26px;
        background: rgba(255, 210, 63, 0.85);
        border: 2px dashed var(--ink);
        transform: translateX(-50%) rotate(-3deg);
      }
      .notes-head { display: flex; align-items: center; justify-content: space-between; }
      .notes h2 { margin: 0; font-size: 1.4rem; font-weight: 700; }
      .progress {
        padding: 2px 12px;
        background: var(--mint);
        border: 2px solid var(--ink);
        border-radius: 999px;
        font-weight: 700;
        font-size: 0.95rem;
      }
      .missions { list-style: none; margin: 1.1rem 0 0; padding: 0; display: grid; gap: 12px; }
      .missions li {
        display: flex;
        gap: 12px;
        align-items: flex-start;
        padding: 12px 14px;
        background: #ffffff;
        border: 3px solid var(--ink);
        border-radius: 16px;
        box-shadow: 3px 3px 0 var(--ink);
        transition: background 0.25s;
      }
      .check {
        flex-shrink: 0;
        display: grid;
        place-items: center;
        width: 26px;
        height: 26px;
        border: 3px solid var(--ink);
        border-radius: 50%;
        background: #ffffff;
        font-size: 0.85rem;
        font-weight: 700;
        color: transparent;
      }
      .missions li.done { background: #dcfff1; }
      .missions li.done .check { background: var(--mint); color: var(--ink); }
      .m-title { margin: 0; font-weight: 600; }
      .m-count { margin-left: 6px; font-size: 0.85rem; font-weight: 500; color: var(--blue); }
      .m-summary { margin: 0.3rem 0 0; font-size: 0.92rem; }
      .reset {
        margin-top: 18px;
        padding: 8px 16px;
        border: 3px solid var(--ink);
        border-radius: 999px;
        background: var(--pink);
        color: var(--ink);
        font: inherit;
        font-weight: 600;
        box-shadow: 3px 3px 0 var(--ink);
        cursor: pointer;
      }
      .reset:hover { transform: translate(-1px, -1px); }
      .fallback { font-weight: 500; }

      /* ---------- 跑马灯 ---------- */
      .marquee {
        overflow: hidden;
        margin: 30px 0;
        padding: 14px 0;
        background: var(--ink);
        transform: rotate(-1.5deg);
        -webkit-mask-image: linear-gradient(90deg, transparent, #000 6%, #000 94%, transparent);
        mask-image: linear-gradient(90deg, transparent, #000 6%, #000 94%, transparent);
      }
      .marquee-track { display: flex; gap: 18px; width: max-content; animation: marquee 30s linear infinite; }
      .marquee:hover .marquee-track { animation-play-state: paused; }
      .chip { display: inline-flex; align-items: center; gap: 18px; font-size: 1.1rem; font-weight: 600; color: var(--cream); white-space: nowrap; }
      .sep { color: var(--sun); }
      @keyframes marquee { to { transform: translateX(-50%); } }

      /* ---------- 通用段落 ---------- */
      .section {
        max-width: 1120px;
        margin: 0 auto;
        padding: clamp(60px, 10vh, 110px) clamp(18px, 5vw, 40px) 0;
        opacity: 0;
        transform: translateY(30px) rotate(-0.5deg);
        transition: opacity 0.7s var(--ease), transform 0.7s var(--ease);
      }
      .section.in { opacity: 1; transform: none; }
      .section-head h2 {
        margin: 0.7rem 0 0;
        font-size: clamp(2.2rem, 5vw, 3.4rem);
        font-weight: 700;
        line-height: 1.05;
        -webkit-text-stroke: 1.5px var(--ink);
        paint-order: stroke fill;
        text-shadow: 3px 3px 0 var(--pink);
      }

      /* ---------- Bento 作品网格 ---------- */
      .bento {
        margin-top: 2.4rem;
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        grid-auto-rows: minmax(230px, auto);
        gap: 24px;
      }
      .tile {
        position: relative;
        display: flex;
        flex-direction: column;
        overflow: hidden;
        padding: 24px;
        background:
          radial-gradient(circle at var(--mx, 90%) var(--my, 8%), color-mix(in srgb, var(--accent) 45%, transparent), transparent 42%),
          var(--cream);
        border: 4px solid var(--ink);
        border-radius: 26px;
        box-shadow: var(--pop);
        text-decoration: none;
        transition: transform 0.2s var(--ease), box-shadow 0.2s;
      }
      .tile:hover { transform: translate(-3px, -3px) rotate(-0.6deg); box-shadow: 10px 10px 0 var(--ink); }
      .tile-wide { grid-column: span 2; grid-row: span 2; padding: 34px; }
      .tile-glyph {
        position: absolute;
        right: -14px;
        top: -14px;
        width: 140px;
        height: 140px;
        fill: none;
        stroke: var(--ink);
        stroke-width: 2.4;
        opacity: 0.25;
        transition: transform 0.6s var(--ease);
      }
      .tile:not(.tile-wide) .tile-glyph { top: auto; bottom: -30px; right: -30px; }
      .tile-wide .tile-glyph { width: 320px; height: 320px; right: -60px; top: -50px; opacity: 0.18; }
      .tile:hover .tile-glyph { transform: rotate(30deg) scale(1.06); }
      .tile-top { display: flex; justify-content: space-between; align-items: center; position: relative; }
      .tile-index { font-weight: 700; font-size: 1.1rem; }
      .tile-lang {
        padding: 3px 12px;
        background: var(--accent);
        border: 3px solid var(--ink);
        border-radius: 999px;
        font-size: 0.85rem;
        font-weight: 700;
      }
      .tile-name { margin: auto 0 0.4rem; padding-top: 2rem; font-size: clamp(1.5rem, 2.6vw, 1.9rem); font-weight: 700; position: relative; }
      .tile-wide .tile-name { font-size: clamp(2.3rem, 4.8vw, 3.8rem); }
      .tile-blurb { margin: 0 0 1.2rem; font-size: 1rem; max-width: 46ch; position: relative; }
      .tile-foot { display: flex; justify-content: space-between; align-items: center; font-weight: 600; position: relative; }
      .tile-open span { display: inline-block; transition: transform 0.2s var(--ease); }
      .tile:hover .tile-open span { transform: translate(3px, -3px); }

      /* ---------- 视觉作品 ---------- */
      .gallery { margin-top: 2.4rem; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 22px; }
      .art {
        position: relative;
        margin: 0;
        aspect-ratio: 1;
        overflow: hidden;
        background: #ffffff;
        border: 4px solid var(--ink);
        border-radius: 22px;
        box-shadow: var(--pop);
        transition: transform 0.2s var(--ease);
      }
      .art:hover { transform: rotate(-1.5deg) scale(1.02); }
      .art-feature { grid-column: span 2; aspect-ratio: 2 / 1; }
      .art img { display: block; width: 100%; height: 100%; object-fit: cover; }
      .art-feature img { object-position: 50% 62%; }
      .art figcaption {
        position: absolute;
        left: 14px;
        bottom: 14px;
        display: flex;
        flex-direction: column;
        padding: 4px 12px;
        background: var(--cream);
        border: 3px solid var(--ink);
        border-radius: 12px;
        opacity: 0;
        transform: translateY(6px);
        transition: opacity 0.2s, transform 0.2s var(--ease);
      }
      .art:hover figcaption, .art:focus-within figcaption { opacity: 1; transform: none; }
      .art-title { font-weight: 700; }
      .art-note { font-size: 0.8rem; font-weight: 500; }

      /* ---------- 关于 ---------- */
      .statement {
        margin: 1.8rem 0 0;
        max-width: 24ch;
        font-size: clamp(2rem, 5vw, 3.6rem);
        line-height: 1.12;
        font-weight: 600;
      }
      .statement mark {
        padding: 0 8px;
        background: var(--mint);
        border: 3px solid var(--ink);
        border-radius: 12px;
        color: var(--ink);
      }
      .stats { display: grid; grid-template-columns: repeat(auto-fit, minmax(170px, 1fr)); gap: 22px; margin: 3rem 0 0; padding: 0; }
      .stats div {
        padding: 22px;
        border: 4px solid var(--ink);
        border-radius: 24px;
        box-shadow: var(--pop);
      }
      .stat-a { background: var(--sun); }
      .stat-b { background: var(--pink); }
      .stat-c { background: var(--mint); }
      .stats dt { font-size: 0.95rem; font-weight: 600; }
      .stats dd { margin: 0.2rem 0 0; font-size: clamp(2.4rem, 5vw, 3.2rem); font-weight: 700; line-height: 1; }
      .about-links { display: flex; gap: 16px; margin-top: 2.2rem; }
      .about-links a {
        padding: 10px 20px;
        background: var(--cream);
        border: 3px solid var(--ink);
        border-radius: 999px;
        box-shadow: 3px 3px 0 var(--ink);
        font-weight: 600;
        text-decoration: none;
        transition: transform 0.12s var(--ease);
      }
      .about-links a:hover { transform: translate(-2px, -2px); }

      /* ---------- 页脚 ---------- */
      .footer {
        max-width: 1120px;
        margin: clamp(90px, 14vh, 160px) auto 0;
        padding: 0 clamp(18px, 5vw, 40px) 40px;
        overflow: hidden;
      }
      .giant {
        font-size: clamp(4.5rem, 19vw, 15rem);
        font-weight: 700;
        line-height: 0.85;
        color: var(--sun);
        -webkit-text-stroke: 4px var(--ink);
        paint-order: stroke fill;
        text-shadow: 10px 10px 0 var(--ink);
        white-space: nowrap;
        user-select: none;
      }
      .footer-row {
        display: flex;
        justify-content: space-between;
        flex-wrap: wrap;
        gap: 10px;
        margin-top: 30px;
        padding: 14px 20px;
        background: var(--cream);
        border: 3px solid var(--ink);
        border-radius: 999px;
        font-weight: 500;
      }

      @media (max-width: 900px) {
        .quest-layout { grid-template-columns: 1fr; }
        .bento { grid-template-columns: repeat(2, minmax(0, 1fr)); grid-auto-rows: auto; }
        .tile-wide { grid-row: auto; }
        .gallery { grid-template-columns: repeat(2, minmax(0, 1fr)); }
      }
      @media (max-width: 600px) {
        .nav-links a:not(.nav-cta) { display: none; }
        .bento { grid-template-columns: 1fr; }
        .tile-wide { grid-column: auto; }
        .tile-wide .tile-glyph { width: 200px; height: 200px; }
        .gallery { grid-template-columns: 1fr; }
        .art-feature { grid-column: auto; aspect-ratio: 1; }
        .dialog { left: 12px; right: 12px; bottom: 14px; padding: 12px 14px; }
        .game { box-shadow: 6px 6px 0 var(--ink); }
      }

      @media (prefers-reduced-motion: reduce) {
        html { scroll-behavior: auto; }
        .marquee-track { animation: none !important; }
        .section { transition: none !important; opacity: 1; transform: none; }
      }
    </style>
  </body>
</html>
