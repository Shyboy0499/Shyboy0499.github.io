---
// 站点唯一页面：顶部是可walk的 3D 世界入口，下方是可访问的静态作品与关于。
// 页面只负责结构与样式；3D 运行时在 scripts/playground.ts，数据在 content/projects.ts。
import { profile, projects } from "../content/projects";

const year = new Date().getFullYear();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{profile.name} — {profile.handle}</title>
    <meta name="description" content={profile.blurb} />
    <meta property="og:title" content={profile.name} />
    <meta property="og:description" content={profile.blurb} />
    <meta property="og:type" content="website" />
    <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'%3E%3Ctext y='.9em' font-size='90'%3E%E2%9C%A6%3C/text%3E%3C/svg%3E" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <nav class="nav">
      <a class="brand" href="#top"><span class="brand-mark">✦</span> {profile.name}</a>
      <div class="nav-links">
        <a href="#work">Work</a>
        <a href="#about">About</a>
        <a class="nav-cta" href={profile.github} target="_blank" rel="noopener noreferrer">GitHub ↗</a>
      </div>
    </nav>

    <main id="top">
      <!-- 3D 可玩入口：画布在底层，文案与卡片叠在上层。 -->
      <section id="play" class="play" aria-label="Interactive 3D introduction">
        <div class="play-canvas" data-canvas></div>

        <div class="play-labels">
          {
            projects.map((p, i) => (
              <a
                class="play-label"
                data-label
                href={p.href}
                target="_blank"
                rel="noopener noreferrer"
                style={`--glow:${p.accent}`}
                hidden
              >
                <span class="label-dot" aria-hidden="true"></span>
                {p.name}
              </a>
            ))
          }
        </div>

        <div class="play-intro" data-intro>
          <p class="eyebrow">{profile.handle} · 3D intro</p>
          <h1 class="title">{profile.name}</h1>
          <p class="lede">{profile.blurb}</p>
          <button class="btn btn-primary play-enter" type="button" data-enter>Enter the world</button>
          <p class="hint">Walk with WASD or arrows · click the ground to move · walk to a crystal to open its card</p>
        </div>

        <div class="play-hud" aria-hidden="true">
          <span>WASD / ↑↓←→ walk</span>
          <span>click to move</span>
          <span>Enter opens nearby project</span>
        </div>

        {
          projects.map((p, i) => (
            <aside class="play-card" data-card style={`--glow:${p.accent}`} hidden>
              <div class="card-top">
                <span class="card-name">{p.name}</span>
                <span class="card-star">★ {p.stars}</span>
              </div>
              <p class="card-blurb">{p.blurb}</p>
              <div class="card-foot">
                <span class="card-lang"><span class="dot" aria-hidden="true"></span>{p.lang}</span>
                <a class="card-open" href={p.href} target="_blank" rel="noopener noreferrer">Open repo ↗</a>
              </div>
              <p class="card-key">Press Enter to open</p>
            </aside>
          ))
        }

        <noscript>
          <style>.play-enter, .hint, .play-hud { display: none; }</style>
        </noscript>
      </section>

      <!-- 静态作品列表：与 3D 入口内容一致，供无 WebGL、无 JS 与屏幕阅读器使用。 -->
      <section id="work" class="section">
        <div class="section-head">
          <h2>Selected work</h2>
          <p>Things I've built, open on GitHub.</p>
        </div>
        <div class="cards">
          {
            projects.map((p) => (
              <a class="card" href={p.href} target="_blank" rel="noopener noreferrer" style={`--glow:${p.accent}`}>
                <div class="card-top">
                  <span class="card-name">{p.name}</span>
                  <span class="card-star">★ {p.stars}</span>
                </div>
                <p class="card-blurb">{p.blurb}</p>
                <div class="card-foot">
                  <span class="card-lang"><span class="dot" aria-hidden="true"></span>{p.lang}</span>
                  <span class="card-arrow">→</span>
                </div>
              </a>
            ))
          }
        </div>
      </section>

      <section id="about" class="section">
        <div class="section-head">
          <h2>About</h2>
        </div>
        <div class="about-body">
          <p>
            I'm a developer who likes building tools that are small, sharp, and a little
            opinionated. Most of my work lives at the seam between developers and agents:
            automation that earns trust by <em>verifying</em> its own work rather than assuming.
          </p>
          <p>When I'm not shipping, I'm tuning my Mac setup until it feels exactly right.</p>
          <div class="about-links">
            <a href={profile.github} target="_blank" rel="noopener noreferrer">GitHub ↗</a>
            <a href={`mailto:${profile.email}`}>Email ↗</a>
          </div>
        </div>
      </section>

      <footer class="footer">
        <span>✦ {profile.name}</span>
        <span class="muted">© {year} · Built with care</span>
      </footer>
    </main>

    <script>
      import { mountPlayground } from "../scripts/playground";
      import { projects } from "../content/projects";

      const play = document.getElementById("play");
      if (play) mountPlayground(play, projects);
    </script>

    <style is:global>
      :root {
        --bg: #07070b;
        --fg: #ecedf2;
        --muted: #9a9bab;
        --line: rgba(255, 255, 255, 0.09);
        --card: rgba(255, 255, 255, 0.035);
        --c1: #7c5cff;
        --c2: #36d6c3;
        --c3: #ff7a59;
        --sans: "Space Grotesk", system-ui, sans-serif;
        --mono: "JetBrains Mono", ui-monospace, monospace;
      }

      * { box-sizing: border-box; }
      html { scroll-behavior: smooth; }
      body {
        margin: 0;
        background: var(--bg);
        color: var(--fg);
        font-family: var(--sans);
        line-height: 1.6;
        overflow-x: hidden;
        -webkit-font-smoothing: antialiased;
      }
      a { color: inherit; }
      [hidden] { display: none !important; }

      /* ---------- Nav ---------- */
      .nav {
        position: fixed;
        top: 0; left: 0; right: 0;
        z-index: 10;
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 18px clamp(20px, 5vw, 56px);
        pointer-events: none;
      }
      .nav > * { pointer-events: auto; }
      .brand { font-weight: 600; text-decoration: none; }
      .brand-mark { color: var(--c1); }
      .nav-links { display: flex; align-items: center; gap: clamp(14px, 3vw, 28px); font-size: 0.92rem; }
      .nav-links a:not(.nav-cta) { text-decoration: none; color: var(--muted); transition: color 0.2s; }
      .nav-links a:not(.nav-cta):hover { color: var(--fg); }
      .nav-cta {
        padding: 7px 15px;
        border: 1px solid var(--line);
        border-radius: 999px;
        text-decoration: none;
        background: rgba(7, 7, 11, 0.5);
        backdrop-filter: blur(8px);
      }
      .nav-cta:hover { border-color: var(--c1); }

      main { margin: 0 auto; }

      /* ---------- 3D 入口 ---------- */
      .play {
        position: relative;
        height: 100vh;
        height: 100svh;
        min-height: 580px;
        overflow: hidden;
        background: radial-gradient(ellipse at 50% 40%, #15122a 0%, var(--bg) 70%);
      }
      .play-canvas { position: absolute; inset: 0; }
      .play-canvas canvas { display: block; width: 100%; height: 100%; }

      .play-labels { position: absolute; inset: 0; pointer-events: none; z-index: 1; }
      .play-label {
        position: absolute;
        top: 0; left: 0;
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 6px 13px;
        border: 1px solid var(--glow);
        border-radius: 999px;
        background: rgba(7, 7, 11, 0.7);
        backdrop-filter: blur(6px);
        font-family: var(--mono);
        font-size: 0.8rem;
        white-space: nowrap;
        text-decoration: none;
        pointer-events: auto;
        opacity: 0;
        transition: opacity 0.6s ease, box-shadow 0.2s;
      }
      .play-label:hover { box-shadow: 0 0 18px var(--glow); }
      .is-entered .play-label { opacity: 1; }
      .label-dot { width: 7px; height: 7px; border-radius: 50%; background: var(--glow); box-shadow: 0 0 8px var(--glow); }

      .play-intro {
        position: absolute;
        left: clamp(20px, 5vw, 64px);
        bottom: clamp(28px, 9vh, 90px);
        max-width: 460px;
        z-index: 2;
        transition: opacity 0.6s ease, transform 0.6s ease;
      }
      .is-entered .play-intro { opacity: 0; transform: translateY(18px); pointer-events: none; }
      .eyebrow { font-family: var(--mono); font-size: 0.8rem; color: var(--c2); margin: 0 0 0.8rem; letter-spacing: 0.04em; }
      .title {
        margin: 0;
        font-size: clamp(3rem, 9vw, 5.8rem);
        line-height: 0.95;
        font-weight: 700;
        letter-spacing: -0.035em;
        background: linear-gradient(100deg, var(--c1), var(--c2) 55%, var(--c3));
        -webkit-background-clip: text;
        background-clip: text;
        color: transparent;
      }
      .lede { color: var(--muted); margin: 1rem 0 0; font-size: clamp(0.98rem, 2vw, 1.08rem); max-width: 44ch; }
      .hint { font-family: var(--mono); font-size: 0.74rem; color: var(--muted); margin: 1.1rem 0 0; opacity: 0.8; }

      .btn {
        display: inline-flex;
        align-items: center;
        margin-top: 1.6rem;
        padding: 13px 26px;
        border: 0;
        border-radius: 999px;
        font: inherit;
        font-weight: 600;
        color: #06060a;
        background: linear-gradient(100deg, var(--c1), var(--c2));
        box-shadow: 0 12px 34px -12px rgba(124, 92, 255, 0.8);
        cursor: pointer;
        transition: transform 0.18s ease, box-shadow 0.25s ease;
      }
      .btn:hover { transform: translateY(-2px); box-shadow: 0 18px 40px -12px rgba(124, 92, 255, 0.95); }
      .btn:focus-visible, .play-label:focus-visible, .card-open:focus-visible, a:focus-visible {
        outline: 2px solid var(--c2);
        outline-offset: 3px;
      }

      .play-hud {
        position: absolute;
        right: clamp(20px, 5vw, 64px);
        bottom: clamp(28px, 9vh, 90px);
        z-index: 2;
        display: flex;
        flex-direction: column;
        align-items: flex-end;
        gap: 4px;
        font-family: var(--mono);
        font-size: 0.74rem;
        color: var(--muted);
        opacity: 0;
        transition: opacity 0.6s ease 0.2s;
        pointer-events: none;
      }
      .is-entered .play-hud { opacity: 0.85; }

      .play-card {
        position: absolute;
        top: 50%;
        right: clamp(20px, 5vw, 64px);
        z-index: 3;
        width: min(340px, calc(100% - 40px));
        padding: 22px;
        border: 1px solid var(--glow);
        border-radius: 18px;
        background: rgba(12, 12, 18, 0.78);
        backdrop-filter: blur(14px);
        transform: translateY(-50%);
        box-shadow: 0 0 40px -12px var(--glow);
        animation: card-in 0.35s ease;
      }
      .play-card .card-blurb { font-size: 0.92rem; }
      .card-key { font-family: var(--mono); font-size: 0.7rem; color: var(--muted); margin: 0.9rem 0 0; }
      @keyframes card-in { from { opacity: 0; transform: translateY(calc(-50% + 10px)); } }

      .no-webgl .play { height: auto; min-height: 60vh; padding: 140px 0 80px; }
      .no-webgl .play-canvas, .no-webgl .play-labels, .no-webgl .play-hud, .no-webgl .play-card, .no-webgl .play-enter, .no-webgl .hint { display: none; }
      .no-webgl .play-intro { position: relative; left: auto; bottom: auto; padding: 0 clamp(20px, 5vw, 40px); }

      /* ---------- 静态段落 ---------- */
      .section { max-width: 1080px; margin: 0 auto; padding: clamp(70px, 12vh, 120px) clamp(20px, 5vw, 40px) 0; }
      .section-head h2 {
        margin: 0;
        font-size: clamp(1.5rem, 4vw, 2.2rem);
        letter-spacing: -0.02em;
      }
      .section-head p { color: var(--muted); margin: 0.4rem 0 0; }

      .cards {
        margin-top: 2.4rem;
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
        gap: 20px;
      }
      .card {
        position: relative;
        display: flex;
        flex-direction: column;
        padding: 26px;
        border: 1px solid var(--line);
        border-radius: 20px;
        background: var(--card);
        text-decoration: none;
        transition: transform 0.2s ease, border-color 0.3s;
      }
      .card:hover { transform: translateY(-4px); border-color: var(--glow); }
      .card-top { display: flex; align-items: baseline; justify-content: space-between; gap: 10px; }
      .card-name { font-size: 1.2rem; font-weight: 600; letter-spacing: -0.01em; }
      .card-star { font-family: var(--mono); font-size: 0.8rem; color: var(--muted); }
      .card-blurb { color: var(--muted); margin: 0.9rem 0 1.5rem; font-size: 0.95rem; flex: 1; }
      .card-foot { display: flex; align-items: center; justify-content: space-between; gap: 12px; }
      .card-lang { font-family: var(--mono); font-size: 0.8rem; display: inline-flex; align-items: center; gap: 8px; }
      .dot { width: 9px; height: 9px; border-radius: 50%; background: var(--glow); box-shadow: 0 0 10px var(--glow); }
      .card-arrow { color: var(--glow); font-size: 1.2rem; transition: transform 0.2s; }
      .card:hover .card-arrow { transform: translateX(5px); }
      .card-open {
        font-family: var(--mono);
        font-size: 0.8rem;
        color: var(--fg);
        text-decoration: none;
        border-bottom: 1px solid var(--glow);
        padding-bottom: 1px;
      }

      .about-body { margin-top: 2rem; max-width: 62ch; }
      .about-body p { color: var(--muted); font-size: clamp(1rem, 2vw, 1.1rem); }
      .about-body em { color: var(--fg); font-style: normal; border-bottom: 1px solid var(--c2); }
      .about-links { display: flex; gap: 22px; margin-top: 1.8rem; font-family: var(--mono); font-size: 0.92rem; }
      .about-links a { text-decoration: none; border-bottom: 1px solid var(--line); padding-bottom: 2px; transition: border-color 0.2s; }
      .about-links a:hover { border-color: var(--c1); }

      .footer {
        max-width: 1080px;
        margin: clamp(70px, 12vh, 120px) auto 0;
        padding: 36px clamp(20px, 5vw, 40px) 56px;
        border-top: 1px solid var(--line);
        display: flex;
        justify-content: space-between;
        flex-wrap: wrap;
        gap: 10px;
        font-size: 0.88rem;
      }
      .footer .muted { color: var(--muted); }

      @media (max-width: 720px) {
        .nav-links a:not(.nav-cta) { display: none; }
        .play-card { top: auto; bottom: 20px; left: 20px; right: 20px; width: auto; transform: none; }
        .play-hud { display: none; }
        .play-intro { right: 20px; }
      }

      @media (prefers-reduced-motion: reduce) {
        html { scroll-behavior: auto; }
        .title { animation: none; }
      }
    </style>
  </body>
</html>
