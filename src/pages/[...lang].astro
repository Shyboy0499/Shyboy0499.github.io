---
// 静态首页宿主：提供可读 Portfolio DOM、Portal shell 和 Runtime 挂载点。
// 具体 3D 体验由 entry.ts 和 World 模块接管，页面本身不拥有渲染生命周期。
// 同一模板生成中文 `/` 与英文 `/en/` 两份静态页面；语言只在构建期由路由参数决定。
import "../styles.css";
import { SITE_CONFIG } from "../site.config";
import {
  portfolioFor,
  type PortfolioCollectionId,
  type PortfolioProjectId,
} from "../content/portfolio";
import { LANG_HOME_PATH, LANG_STORAGE_KEY, t, type Lang } from "../i18n";
import { cosmicBinding } from "../worlds/cosmic/binding";
import { createLiquidWorldPlacement } from "../worlds/world-picker-layout";
import { WORLD_NAMING } from "../worlds/worlds.config";

export function getStaticPaths() {
  return [{ params: { lang: undefined } }, { params: { lang: "en" } }];
}

const lang: Lang = Astro.params.lang === "en" ? "en" : "zh";
const otherLang: Lang = lang === "en" ? "zh" : "en";
const L = (zh: string, en: string): string => t(zh, en, lang);
const portfolio = portfolioFor(lang);
const portfolioCollectionById = (id: PortfolioCollectionId) =>
  portfolio.collections.find((collection) => collection.id === id)!;
const portfolioProjectById = (id: PortfolioProjectId) =>
  portfolio.projects.find((project) => project.id === id)!;
const { metadata, person } = portfolio;
const { navigation, hero, contact } = cosmicBinding;
const collections = cosmicBinding.collections.map((binding) => ({
  ...portfolioCollectionById(binding.portfolioId),
  ...binding,
  titleLines:
    (lang === "en" && "titleLinesEn" in binding && binding.titleLinesEn) || binding.titleLines,
}));
const openSourceProjects = cosmicBinding.projects.map((binding) => ({
  ...portfolioProjectById(binding.portfolioId),
  ...binding,
}));
const collaborationProjects = cosmicBinding.collaborations.map((binding) => ({
  ...portfolioProjectById(binding.portfolioId),
  ...binding,
}));
const collaborationMergedPrTotal = collaborationProjects.reduce(
  (total, project) =>
    total +
    Number.parseInt(
      project.metrics.find((metric) => metric.label === "MERGED PRS")?.value ??
        "0",
      10,
    ),
  0,
);

// 世界入口只读取命名索引；新增 World 并配置 entryPoster 后会自动加入液态拼贴。
const selectableWorlds = Object.values(WORLD_NAMING).filter(
  (world) => world.id !== WORLD_NAMING.cosmic.id,
);
const worldChoices = selectableWorlds.map((world, index) => {
  const desktop = createLiquidWorldPlacement(index, selectableWorlds.length, 3);
  const mobile = createLiquidWorldPlacement(index, selectableWorlds.length, 2);
  return {
    id: world.id,
    label: lang === "en" ? world.englishTitle : world.chineseTitle,
    poster: `/${world.entryPoster}`,
    variant: index % 6,
    style: [
      `--liquid-left:${desktop.left}%`,
      `--liquid-top:${desktop.top}%`,
      `--liquid-width:${desktop.width}%`,
      `--liquid-height:${desktop.height}%`,
      `--liquid-mobile-left:${mobile.left}%`,
      `--liquid-mobile-top:${mobile.top}%`,
      `--liquid-mobile-width:${mobile.width}%`,
      `--liquid-mobile-height:${mobile.height}%`,
    ].join(";"),
  };
});
const buildLogSlides = [
  {
    focusId: "build-01-hello-deepseek",
    number: "01",
    eyebrow: "START",
    title: "Hello, DeepSeek",
    summary: L("从一个 API key 开始。", "It started with an API key."),
    description:
      L(
        "第一次调用 DeepSeek，把“模型能做什么”从新闻里的概念变成自己终端里的输出，也是后面所有项目的起点。",
        "My first DeepSeek call turned \"what models can do\" from a headline into output in my own terminal — the starting point for everything after.",
      ),
    src: "/assets/build-log/build-01-hello-deepseek.webp",
    alt: L("Hello, DeepSeek 构建日志卡片", "Hello, DeepSeek build log card"),
  },
  {
    focusId: "build-02-curate-ecosystem",
    number: "02",
    eyebrow: "LIST",
    title: L("整理 DeepSeek Harness 生态", "Curate the Ecosystem"),
    summary: L("先把散落的工具整理成一张地图。", "First, map the scattered tools."),
    description:
      L(
        "把 DeepSeek Harness 生态里的插件、技能、MCP 服务器与工具收集成可持续更新的中文清单，边整理边弄清楚生态是怎么拼起来的。",
        "Collecting plugins, skills, MCP servers and tools from the DeepSeek Harness ecosystem into a living list — and learning how the pieces fit along the way.",
      ),
    src: "/assets/build-log/build-02-curate-ecosystem.webp",
    alt: L("整理 DeepSeek Harness 生态清单卡片", "Curating the DeepSeek Harness ecosystem card"),
  },
  {
    focusId: "build-03-ship-plugin",
    number: "03",
    eyebrow: "PLUGIN",
    title: L("发布 dsh-git-tools", "Ship dsh-git-tools"),
    summary: L("从使用者变成插件作者。", "From user to plugin author."),
    description:
      L(
        "为 dsh 写本地 git 工具：git_status、git_diff、git_log、git_commit，让 agent 可以更顺手地操作仓库。",
        "Local git tools for dsh — git_status, git_diff, git_log, git_commit — so agents can work with repositories more smoothly.",
      ),
    src: "/assets/build-log/build-03-ship-plugin.webp",
    alt: L("dsh-git-tools 插件构建日志卡片", "dsh-git-tools plugin build log card"),
  },
  {
    focusId: "build-04-open-source-prs",
    number: "04",
    eyebrow: "COLLAB",
    title: L("向开源生态提交 PR", "Open Source PRs"),
    summary: L("不只做自己的项目，也修别人的路。", "Not just my own projects — fixing roads for others too."),
    description:
      L(
        "在 DeepSeek Harness 生态里提交 PR、维护清单、修复文档与构建路径问题，在协作中学习真实工程的节奏。",
        "Pull requests across the DeepSeek Harness ecosystem — maintaining lists, fixing docs and build paths, and learning the rhythm of real engineering.",
      ),
    src: "/assets/build-log/build-04-open-source-prs.webp",
    alt: L("开源 PR 构建日志卡片", "Open-source PRs build log card"),
  },
  {
    focusId: "build-05-knowledge-llm",
    number: "05",
    eyebrow: "BUILDING",
    title: "Knowledge × LLM",
    summary: L("让模型服务于自己的知识库。", "Making the model serve my own knowledge base."),
    description:
      L(
        "DeepSeek-Obsidian 把 DeepSeek 工作流接入 Obsidian，正在探索笔记的总结、沉淀与检索。",
        "DeepSeek-Obsidian brings DeepSeek workflows into Obsidian, exploring how notes get summarised, kept and retrieved.",
      ),
    src: "/assets/build-log/build-05-knowledge-llm.webp",
    alt: L("DeepSeek-Obsidian 构建日志卡片", "DeepSeek-Obsidian build log card"),
  },
  {
    focusId: "build-06-learn-by-building",
    number: "06",
    eyebrow: "STUDY",
    title: L("边学边做", "Learn by Building"),
    summary: L("在悉尼学习 LLM 与机器学习。", "Studying LLMs and machine learning in Sydney."),
    description:
      L(
        "课程给出原理，项目给出问题；把学到的东西尽快做成可以运行、可以开源的工具。",
        "Courses give the principles, projects give the problems — and I turn what I learn into tools that run and ship in the open.",
      ),
    src: "/assets/build-log/build-06-learn-by-building.webp",
    alt: L("边学边做构建日志卡片", "Learn by building card"),
  },
  {
    focusId: "build-07-this-room",
    number: "07",
    eyebrow: "NOW",
    title: L("这个房间", "This Room"),
    summary: L("把作品集做成一个可以走进去的 3D 空间。", "A portfolio you can walk into."),
    description:
      L(
        "用 Three.js 搭出桌面、键盘与霓虹灯，让每一件作品都成为房间里可以点开的陈设。",
        "A desk, a keyboard and neon lights built in Three.js — every project becomes something in the room you can click open.",
      ),
    src: "/assets/build-log/build-07-this-room.webp",
    alt: L("3D 作品集房间构建日志卡片", "3D portfolio room build log card"),
  },
] as const;

const routes = [
  { id: hero.id, number: hero.number, route: hero.route },
  ...collections.map(({ id, number, route }) => ({ id, number, route })),
];
---

<!doctype html>
<html lang={lang === "en" ? "en" : "zh-CN"}>
  <head>
    <meta charset="UTF-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1, viewport-fit=cover"
    />
    <meta name="description" content={metadata.description} />
    <meta name="theme-color" content="#05070a" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta property="og:title" content={metadata.title} />
    <meta property="og:description" content={metadata.ogDescription} />
    <meta property="og:image" content={SITE_CONFIG.ogImagePath} />
    <meta property="og:type" content="website" />
    <title>{metadata.title}</title>
    <link rel="icon" href={SITE_CONFIG.iconPath} />
    <link rel="manifest" href={SITE_CONFIG.manifestPath} />
    <link rel="alternate" hreflang="zh-CN" href={new URL(LANG_HOME_PATH.zh, Astro.site)} />
    <link rel="alternate" hreflang="en" href={new URL(LANG_HOME_PATH.en, Astro.site)} />
    {/* 首次访问按浏览器语言跳转；用户手动选择过语言后只尊重保存的偏好。必须在首屏渲染前执行。 */}
    <script is:inline define:vars={{ lang, otherLang, paths: LANG_HOME_PATH, key: LANG_STORAGE_KEY }}>
      let saved = null;
      try { saved = localStorage.getItem(key); } catch {}
      const preferred = saved ?? (navigator.language.toLowerCase().startsWith("zh") ? "zh" : "en");
      // 明确打开的 /en/ 链接只在用户保存过中文偏好时才跳回，避免分享链接被浏览器语言改写。
      if (preferred === otherLang && (lang === "zh" || saved === otherLang)) {
        location.replace(paths[otherLang] + location.search + location.hash);
      }
    </script>
  </head>
  <body>
    <a class="skip-link" href="#story">{L("跳到主要内容", "Skip to main content")}</a>

    <!-- Runtime-owned WebGL surface and loading state. -->
    <div class="experience" aria-hidden="true">
      <canvas id="world"></canvas>
    </div>

    <div class="loader" data-loader aria-hidden="true">
      <div class="loader-mark">{person.shortName}</div>
      <div class="loader-track"><span data-loader-bar></span></div>
      <p>INITIALIZING WORLD</p>
    </div>

    <!-- Persistent navigation remains usable independently of the 3D World. -->
    <header class="site-header">
      <a class="brand" href="#origin" aria-label={L("Shyboy0499 首页", "Shyboy0499 home")}>
        <span class="brand-mark">{person.shortName}</span>
        <span class="brand-name">{person.name}</span>
      </a>
      <nav aria-label={L("主要导航", "Main navigation")}>
        {navigation.map((item) => <a href={`#${item.id}`}>{item.label}</a>)}
        <a href={SITE_CONFIG.assetGalleryPath}>{L("3D资产", "3D ASSETS")}</a>
      </nav>
      <div class="header-actions">
        <a
          class="github-link"
          href={SITE_CONFIG.githubUrl}
          target="_blank"
          rel="noreferrer"
          aria-label={L("打开 Shyboy0499 的 GitHub", "Open Shyboy0499 on GitHub")}
        >
          GH ↗
        </a>
        <a
          class="lang-toggle"
          href={LANG_HOME_PATH[otherLang]}
          hreflang={otherLang === "en" ? "en" : "zh-CN"}
          data-lang-switch={otherLang}
          aria-label={L("Switch to English", "切换到中文")}
        >
          {otherLang === "en" ? "EN" : "中文"}
        </a>
      </div>
    </header>

    <aside class="route-rail" aria-label={L("五个总览章节", "Five overview chapters")}>
      <span class="route-line"></span>
      {routes.map((route, index) => (
        <a
          href={`#${route.id}`}
          class={index === 0 ? "is-active" : undefined}
          data-route={index}
        >
          <span>{route.number}</span><b>{route.route}</b>
        </a>
      ))}
    </aside>

    <!-- Shared portal shell; each World supplies its destination and proximity. -->
    <div class="portal-layer" data-portal-layer data-state="dormant" hidden>
      <button class="portal-trigger" type="button" data-portal-trigger disabled>
        <span data-portal-eyebrow>WORLD GATE</span>
        <strong data-portal-label>ENTER THE TIDAL GATE</strong>
        <small data-portal-target>ARCHIPELAGO</small>
      </button>
      <div class="portal-transition" data-portal-transition aria-hidden="true">
        <img data-portal-snapshot alt="" />
        <div class="portal-effect" aria-hidden="true"></div>
        <p data-portal-status role="status" aria-live="polite"></p>
      </div>
    </div>

    <!-- Vertical overview story. DOM scroll progress drives the main camera path. -->
    <main class="story" id="story">
      <section class="chapter chapter-hero" id={hero.id} data-scene="0">
        <div class="chapter-copy align-left">
          <p class="eyebrow"><span>{hero.number}</span> {hero.eyebrow}</p>
          <h1>{person.name}<span>.</span></h1>
          <p class="hero-line">
            {L(hero.line, hero.lineEn)}<br />
            <strong>{L(hero.emphasis, hero.emphasisEn)}</strong>
          </p>
          <div class="hero-meta">
            <span>{person.location}</span>
            <span>{hero.since}</span>
          </div>
        </div>
        <div class="chapter-index" aria-hidden="true">{hero.number}</div>
        <div class="next-signal" aria-hidden="true">
          {hero.signals.map((signal) => <span>{signal}</span>)}
        </div>
      </section>

      {collections.map((collection, index) => (
        <section
          class:list={[
            "chapter",
            "collection-overview",
            collection.id === "projects" && "world-picker-overview",
          ]}
          id={collection.id}
          data-scene={index + 1}
        >
          <div class={`chapter-copy align-${collection.align}`}>
            {collection.id === "projects" ? (
              <>
                <svg class="world-liquid-filter" aria-hidden="true">
                  <filter
                    id="world-liquid-distortion"
                    x="-8%"
                    y="-12%"
                    width="116%"
                    height="124%"
                    color-interpolation-filters="sRGB"
                  >
                    <feTurbulence
                      type="fractalNoise"
                      baseFrequency="0.009 0.022"
                      numOctaves="3"
                      seed="17"
                      result="liquid-noise"
                    />
                    <feDisplacementMap
                      in="SourceAlpha"
                      in2="liquid-noise"
                      scale="48"
                      xChannelSelector="R"
                      yChannelSelector="B"
                      result="liquid-alpha"
                    />
                    <feComposite
                      in="SourceGraphic"
                      in2="liquid-alpha"
                      operator="in"
                    />
                  </filter>
                </svg>
                <div class="world-select" aria-label={L("选择要进入的世界", "Choose a world to enter")}>
                  {worldChoices.map((world) => (
                    <button
                      class="world-select-card"
                      type="button"
                      data-world-choice={world.id}
                      data-liquid-variant={world.variant}
                      aria-label={L(`进入${world.label}`, `Enter ${world.label}`)}
                      style={world.style}
                    >
                      <img src={world.poster} alt="" loading="lazy" />
                    </button>
                  ))}
                </div>
              </>
            ) : (
              <>
                <p class="eyebrow">
                  <span>{collection.number}</span> {collection.eyebrow}
                </p>
                <h1
                  class="collection-title"
                  set:html={collection.titleLines.join("<br />")}
                />
                <p class="lead">{collection.summary}</p>
                <p class="body-copy">{collection.description}</p>

                {collection.enterLabel && (
                  <button
                    class="enter-collection"
                    type="button"
                    data-collection-enter={collection.id}
                  >
                    <span>{collection.enterLabel}</span>
                    <b aria-hidden="true">→</b>
                  </button>
                )}
              </>
            )}
          </div>
          {collection.id !== "projects" && (
            <>
              <div class="chapter-index" aria-hidden="true">
                {collection.number}
              </div>
              <div class="next-signal" aria-hidden="true">
                {collection.signals.map((signal) => (
                  <span>
                    {collection.id === "internship" && signal === "MERGED PRS"
                      ? `${collaborationMergedPrTotal} ${signal}`
                      : signal}
                  </span>
                ))}
              </div>
            </>
          )}
        </section>
      ))}

      <section class="contact" id="contact">
        <p class="eyebrow"><span>{contact.number}</span> {contact.eyebrow}</p>
        <h2>{contact.title}<br /><i>{contact.emphasis}</i></h2>
        <div class="contact-links">
          {person.links.map((link) => (
            <a href={link.href} target="_blank" rel="noreferrer">
              {link.label} <span>↗</span>
            </a>
          ))}
        </div>
        <footer>
          <span>© <b data-year></b> {person.name}</span>
          <span>REAL-TIME WEBGL / BUILT ON GITHUB</span>
          <a href="#origin">BACK TO ORIGIN ↑</a>
        </footer>
      </section>
    </main>

    <!-- Lateral project branch layered above the overview without changing URL. -->
    <section
      class="collection-detail"
      data-collection-detail
      aria-hidden="true"
      inert
      aria-label={L("开源项目群详情", "Project collection details")}
    >
      <div class="detail-toolbar">
        <button class="detail-back" type="button" data-collection-exit>
          <span aria-hidden="true">←</span>
          <b>BACK</b>
        </button>
        <div class="detail-counter" aria-hidden="true">
          <b data-collection-current>01</b>
          <span>/</span>
          <span data-collection-total>{String(openSourceProjects.length).padStart(2, "0")}</span>
        </div>
      </div>

      <div class="detail-panels">
        {openSourceProjects.map((project, index) => (
          <article
            class:list={[
              "project-detail",
              `detail-align-${project.align}`,
              index === 0 && "is-active",
            ]}
            data-collection-item="open-source"
            data-collection-focus={project.id}
            data-collection-label={project.titleLines.join(" ")}
            aria-hidden={index === 0 ? "false" : "true"}
          >
            <div class="project-detail-copy">
              <p class="eyebrow">
                <span>{project.number}</span> {project.eyebrow}
              </p>
              <h2 set:html={project.titleLines.join("<br />")} />
              <p class="lead">{project.summary}</p>
              <p class="body-copy">{project.description}</p>
              <dl class="metrics">
                {project.metrics.map((metric) => (
                  <div>
                    <dt>{metric.label}</dt>
                    <dd>{metric.value}</dd>
                  </div>
                ))}
              </dl>
              <div class="chapter-links">
                {project.links.map((link) => (
                  <a href={link.href} target="_blank" rel="noreferrer">
                    {link.label} ↗
                  </a>
                ))}
              </div>
            </div>
          </article>
        ))}
        {collaborationProjects.map((project) => {
          const cover = project.media.find((media) => media.role === "cover");
          return (
          <article
            class:list={[
              "project-detail",
              "collab-detail",
              `detail-align-${project.align}`,
            ]}
            data-collection-item="internship"
            data-collection-focus={project.id}
            data-collection-label={project.titleLines.join(" ")}
            aria-hidden="true"
          >
            <div class="collab-detail-grid">
              <div class="project-detail-copy collab-detail-copy">
                <p class="eyebrow">
                  <span>{project.number}</span> {project.eyebrow}
                </p>
                <h2 set:html={project.titleLines.join("<br />")} />
                <p class="lead">{project.summary}</p>
                <p class="body-copy">{project.description}</p>
                <dl class="metrics">
                  {project.metrics.map((metric) => (
                    <div>
                      <dt>{metric.label}</dt>
                      <dd>{metric.value}</dd>
                    </div>
                  ))}
                </dl>
                <div class="chapter-links">
                  {project.links.map((link) => (
                    <a href={link.href} target="_blank" rel="noreferrer">
                      {link.label} ↗
                    </a>
                  ))}
                </div>
              </div>
              {cover && (
                <figure class="collab-detail-media">
                  <img src={cover.src} alt={cover.alt} loading="lazy" />
                  {cover.caption && <figcaption>{cover.caption}</figcaption>}
                </figure>
              )}
            </div>
          </article>
          );
        })}
        {buildLogSlides.map((slide, index) => (
          <article
            class:list={[
              "project-detail",
              "ride-detail",
              index % 2 === 0 ? "detail-align-right" : "detail-align-left",
              index === 0 && "is-active",
            ]}
            data-collection-item="life"
            data-collection-focus={slide.focusId}
            data-collection-label={slide.title}
            aria-hidden={index === 0 ? "false" : "true"}
          >
            <div class="ride-detail-grid">
              <div class="project-detail-copy ride-detail-copy">
                <p class="eyebrow">
                  <span>{slide.number}</span> {slide.eyebrow}
                </p>
                <h2>{slide.title}</h2>
                <p class="lead">{slide.summary}</p>
                <p class="body-copy">{slide.description}</p>
                <dl class="metrics">
                  <div>
                    <dt>TRACK</dt>
                    <dd>BUILD LOG</dd>
                  </div>
                  <div>
                    <dt>STEP</dt>
                    <dd>{slide.number}</dd>
                  </div>
                  <div>
                    <dt>MODE</dt>
                    <dd>BUILD</dd>
                  </div>
                </dl>
              </div>
              <figure class="ride-detail-media">
                <img src={slide.src} alt={slide.alt} loading={index === 0 ? "eager" : "lazy"} />
              </figure>
            </div>
          </article>
        ))}
      </div>
    </section>

    <noscript>
      <div class="noscript">
        {L(
          "此页面需要 JavaScript 才能显示 3D 场景，但所有项目链接仍可通过页面文字访问。",
          "This page needs JavaScript to show the 3D scene, but every project link is still available in the page text.",
        )}
      </div>
    </noscript>

    {/* 切换语言时保存偏好，并保留当前世界参数与锚点。 */}
    <script is:inline define:vars={{ key: LANG_STORAGE_KEY }}>
      document.querySelectorAll("[data-lang-switch]").forEach((link) => {
        link.addEventListener("click", (event) => {
          event.preventDefault();
          try { localStorage.setItem(key, link.dataset.langSwitch); } catch {}
          location.href = link.getAttribute("href") + location.search + location.hash;
        });
      });
    </script>
    <script src="../entry.ts"></script>
  </body>
</html>
