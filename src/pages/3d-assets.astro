const jianghuAgentSpriteAssets = JIANGHU_AGENTS.flatMap((agent) => {
  if (agent.asset === "guest") {
    return (["idle", "urge", "walk-a", "walk-b"] as const).map((pose) => ({
      id: `jianghu-agent-${agent.folder}-${pose}`,
      worldId: "jianghu",
      title: `${agent.name} · ${jianghuGuestPoseLabels[pose]}`,
      world: "Jianghu World",
      file: `public/jianghu-world/agents/${agent.folder}/${pose}.webp`,
      poster: `/jianghu-world/agents/${agent.folder}/${pose}.webp`,
      tags: ["访客 sprite", agent.role, jianghuGuestPoseLabels[pose]],
      note: `${agent.name} 使用 guest 通用 sprite，${pose}.webp 是它的 ${jianghuGuestPoseLabels[pose]} 姿态。`,
    }));
  }
  return (["doze", "startle", "cheer", "alert"] as const).map((pose) => {
    const fileName = pose === "alert" ? `${pose}.webp` : `${agent.asset}-${pose}.webp`;
    return {
      id: `jianghu-agent-${agent.folder}-${pose}`,
      worldId: "jianghu",
      title: `${agent.name} · ${jianghuPoseLabels[pose]}`,
      world: "Jianghu World",
      file: `public/jianghu-world/agents/${agent.folder}/${fileName}`,
      poster: `/jianghu-world/agents/${agent.folder}/${fileName}`,
      tags: ["角色 sprite", agent.role, jianghuPoseLabels[pose]],
      note: `${agent.name} 的 ${jianghuPoseLabels[pose]} 姿态图片，运行时由 JianghuScene 根据对话和状态切换。`,
    };
  });
});

