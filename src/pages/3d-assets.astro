const textSourceExtensions = [".ts", ".astro", ".css", ".js", ".json", ".md"] as const;

const normalizeAssetSourceRef = (ref: string, fallbackDir = ""): string | null => {
  const trimmed = ref.trim();
  if (!trimmed) return null;
  const candidate = trimmed.includes("/") || !fallbackDir ? trimmed : `${fallbackDir}/${trimmed}`;
  const normalized = candidate.replaceAll("\\", "/");
  if (!textSourceExtensions.some((extension) => normalized.endsWith(extension))) return null;
  if (!normalized.startsWith("src/") && !normalized.startsWith("public/")) return null;
  return normalized;
};

const assetSourceRefs = (file: string): readonly string[] => {
  const refs: string[] = [];
  let fallbackDir = "";
  file.split(/\s+\+\s+/).forEach((part) => {
    const normalized = normalizeAssetSourceRef(part, fallbackDir);
    if (!normalized) return;
    fallbackDir = normalized.includes("/") ? normalized.slice(0, normalized.lastIndexOf("/")) : "";
    refs.push(normalized);
  });
  return refs;
};

const assetCopyIndex = Object.fromEntries(
  previewAssets.map((asset) => {
    const codeRefs = assetSourceRefs(asset.file);
    return [
      asset.id,
      {
        title: asset.title,
        world: asset.world,
        file: asset.file,
        note: asset.note,
        tags: asset.tags,
        codeRefs,
      },
    ];
  }),
);
const sourceModuleKey = (ref: string): string | null =>
  ref.startsWith("src/") ? `../${ref.slice("src/".length)}` : null;
const assetSourceFiles = Object.fromEntries(
  [...new Set(Object.values(assetCopyIndex).flatMap((asset) => asset.codeRefs))]
    .map((ref) => {
      const key = sourceModuleKey(ref);
      return [ref, key ? sourceModules[key] ?? null : null];
    }),
);
const assetSourcePayload = JSON.stringify({
  assets: assetCopyIndex,
  files: assetSourceFiles,
}).replaceAll("<", "\\u003c");

const assetWorldIndexes = new Map<string, number>();
const numberedPreviewAssets = previewAssets.map((asset, index) => {
  const worldId = asset.worldId ?? "archipelago";
  const worldIndex = (assetWorldIndexes.get(worldId) ?? 0) + 1;
  assetWorldIndexes.set(worldId, worldIndex);
  return {
    ...asset,
    globalNumber: String(index + 1).padStart(2, "0"),
    worldNumber: String(worldIndex).padStart(2, "0"),
  };
});
