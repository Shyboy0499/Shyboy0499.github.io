<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="description" content="Shyboy0499 站点 Three.js 资产图谱。" />
    <meta name="theme-color" content="#05070a" />
    <title>3D Assets · Shyboy0499</title>
    <link rel="icon" href={SITE_CONFIG.iconPath} />
  </head>
  <body class="asset-page">
    <header class="asset-header"></header>

    <main class="asset-main">
      <section class="asset-toolbar" aria-label="资产筛选">
        <div class="asset-filter-bar" aria-label="资产筛选">
          <button type="button" data-asset-filter="all" aria-pressed="true">全部资产</button>
          <button type="button" data-asset-filter="cosmic" aria-pressed="false">Cosmic</button>
          <button type="button" data-asset-filter="archipelago" aria-pressed="false">Archipelago</button>
          <button type="button" data-asset-filter="jianghu" aria-pressed="false">Jianghu</button>
          <button type="button" data-asset-filter="linework" aria-pressed="false">Linework</button>
          <button type="button" data-asset-filter="studio" aria-pressed="false">Studio</button>
        </div>
      </section>

      <section
        class="asset-preview-grid"
        id="preview"
        aria-label="3D 资产预览"
        data-asset-gallery
        tabindex="0"
      >
        {numberedPreviewAssets.map((asset) => (
          <article class="asset-card" data-asset-world={asset.worldId ?? "archipelago"}>
            <button
              class="asset-open"
              type="button"
              data-asset-open={asset.id}
              aria-label={`查看 ${asset.title} 的资产说明`}
            >
              <span class="asset-kind" aria-hidden="true">●</span>
              {"poster" in asset && asset.poster ? (
                <img class="asset-poster" src={asset.poster} alt={`${asset.title} 预览`} loading="lazy" />
              ) : (
                <canvas data-asset-preview={asset.id} aria-label={`${asset.title} 3D 预览`}></canvas>
              )}
              <span class="asset-bottom">
                <strong>
                  <span
                    data-asset-number
                    data-asset-number-all={asset.globalNumber}
                    data-asset-number-world={asset.worldNumber}
                  >
                    {asset.globalNumber}
                  </span>
                  {asset.title}
                </strong>
              </span>
            </button>
            <button
              class="asset-copy-button"
              type="button"
              data-asset-copy={asset.id}
              aria-label={`复制 ${asset.title} 的源码`}
              title="复制源码"
            >
              <span>Copy</span>
            </button>
            <div class="asset-detail-source" id={`asset-detail-${asset.id}`} hidden>
              <p data-detail-world>{asset.world}</p>
              <h2>{asset.title}</h2>
              <p>{asset.note}</p>
              <code>{asset.file}</code>
              <div>
                {asset.tags.map((tag) => <span>{tag}</span>)}
              </div>
            </div>
          </article>
        ))}
      </section>

      <dialog class="asset-detail-dialog" data-asset-dialog aria-label="3D 资产详情">
        <button class="asset-dialog-close" type="button" data-asset-close aria-label="关闭详情">×</button>
        <div class="asset-dialog-preview" data-asset-dialog-preview></div>
        <div class="asset-dialog-copy" data-asset-dialog-copy></div>
        <section class="asset-dialog-map" aria-labelledby="asset-map-title">
          <h3 id="asset-map-title">资产文件归属</h3>
          {assetMap.map((group) => (
            <details>
              <summary>{group.group}</summary>
              <div>
                {group.items.map(([name, file, detail]) => (
                  <article>
                    <strong>{name}</strong>
                    <code>{file}</code>
                    <p>{detail}</p>
                  </article>
                ))}
              </div>
            </details>
          ))}
        </section>
      </dialog>
    </main>

    <script id="asset-source-payload" type="application/json" is:inline set:html={assetSourcePayload}></script>
    <script src="../asset-gallery.ts"></script>
  </body>
</html>
